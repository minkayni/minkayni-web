---
import faviconSrc from "/public/favicon.png";
import faviconSvgSrc from "/public/favicon.svg";
import shareImageSrc from "../../assets/FOTO_BATUCADA.webp";
import { getImage } from "astro:assets";
import { globalFallback } from "../../data/pages/global";
import { loadPageContent } from "../../utils/page-content";
import Analytics from "../../components/Analytics.astro";
import CookieConsent from "../../components/CookieConsent.astro";
import FontFaces from "../../components/FontFaces.astro";
import OrganizationJsonLd from "../../components/legal/OrganizationJsonLd.astro";
import PageJsonLd from "../../components/legal/PageJsonLd.astro";
import { alternatePaths, defaultLocale, getLocale, htmlLang, ogLocale } from "../../i18n";
import { CADUCIDAD_VISITA_MS, CLAVE_VISITA } from "../../scripts/visita-config";

/* Sin `<link rel="preload" as="font">`. Se precargaban las tres variantes
   que pintan casi todo el texto para que no se viera primero con la fuente
   del sistema; pero Chrome trata una fuente precargada como bloqueante del
   pintado: retiene el primer cuadro hasta que llega (o vence un plazo), y
   con tres fuentes y una red lenta la página estuvo en blanco 2,7 s en el
   análisis de PageSpeed de escritorio. Medido sin JavaScript en local: primer
   pintado a 640 ms con las precargas, a 116 ms sin ellas; con una sola, 590.
   Como el CSS va ahora dentro del HTML (astro.config.ts), las @font-face se
   conocen en cuanto llega la cabecera y las fuentes se piden igual de pronto,
   solo que sin retener el pintado: el texto sale con la fuente de respaldo
   —ajustada a las métricas de la propia, ver src/styles/global.css— y cambia
   al llegar la buena. */

interface Props {
    title: string;
    description?: string;
    /** Páginas que no deben indexarse (404, borradores): sin canonical y con robots noindex. */
    noindex?: boolean;
    /** Imagen para redes sociales. URL absoluta o ruta del sitio; si falta se usa la del CMS o la de por defecto. */
    image?: string;
    /** Texto alternativo de `image`. */
    imageAlt?: string;
    /** La página trae la intro de la portada (IntroVideo). Solo la portada. */
    intro?: boolean;
}
const appleTouchIcon = await getImage({
    src: faviconSrc,
    width: 180,
    height: 180,
    format: "png",
});
const faviconSvg = await getImage({ src: faviconSvgSrc, format: "svg" });
/* Sustituye a /favicon.ico, que no existe en public/ y devolvía 404 en cada página. */
const faviconPng = await getImage({ src: faviconSrc, width: 32, height: 32, format: "png" });

/* SEO por defecto editable (single type `global` en Strapi), en el idioma
   de la página. */
const locale = getLocale(Astro.url);
const site = await loadPageContent("globalSettings", globalFallback, locale);
const { title, description = site.defaultSeo.metaDescription, noindex = false, image, imageAlt, intro = false } = Astro.props;
const siteTitle = site.defaultSeo.metaTitle || site.siteName;
const fullTitle = title ? `${title} ${site.titleSuffix}` : siteTitle;

/* URL canónica de la página (requiere `site` en astro.config.ts).
   Una página de error no declara canónica: no es un destino real. */
const canonical = !noindex && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

/* Las dos versiones de esta misma página, para `hreflang`. Sin ellas un
   buscador no sabe que /about y /en/about son la misma página en dos idiomas
   y puede tratar una como duplicado de la otra. `x-default` apunta al
   español, que es el idioma del sitio y el destino razonable para quien no
   encaje en ninguno de los dos. Una página `noindex` no las declara: no
   pertenece al índice, así que tampoco a un grupo de alternativas. */
const alternates =
    !noindex && Astro.site
        ? alternatePaths(Astro.url).map(({ locale: code, path }) => ({
              locale: code,
              href: new URL(path, Astro.site).href,
          }))
        : [];
const defaultAlternate = alternates.find((alt) => alt.locale === defaultLocale);

/* Imagen para compartir: la que pase la página, la del single type `global`
   o, como último recurso, una foto del proyecto recortada a 1200x630 (la
   proporción que esperan Facebook, LinkedIn y X). Las redes exigen URL
   absoluta: una ruta relativa se ignora y la tarjeta sale sin imagen. */
const defaultShareImage = await getImage({ src: shareImageSrc, width: 1200, height: 630, format: "webp" });
const shareImagePath = image ?? (site.defaultSeo as { shareImage?: { url?: string } }).shareImage?.url ?? defaultShareImage.src;
const shareImage = Astro.site ? new URL(shareImagePath, Astro.site).href : shareImagePath;
const shareImageAlt = imageAlt ?? `${siteTitle} — Batucada Popular`;
const ogUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

---

<!doctype html>
<html lang={htmlLang[locale]}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
        <link rel="icon" href={faviconPng.src} type="image/png" sizes="32x32" />
        <link rel="icon" href={faviconSvg.src} type="image/svg+xml" />
        <link rel="apple-touch-icon" href={appleTouchIcon.src} />
        <meta name="generator" content={Astro.generator} />

        <meta name="description" content={description} />
        {canonical && <link rel="canonical" href={canonical} />}
        {alternates.map((alt) => <link rel="alternate" hreflang={htmlLang[alt.locale]} href={alt.href} />)}
        {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}
        {noindex && <meta name="robots" content="noindex, follow" />}

        <!-- Open Graph / Twitter: sin esto, al compartir un enlace no hay
             título, descripción ni imagen de vista previa. -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={site.siteName} />
        <meta property="og:locale" content={ogLocale[locale]} />
        {alternates.filter((alt) => alt.locale !== locale).map((alt) => <meta property="og:locale:alternate" content={ogLocale[alt.locale]} />)}
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        {ogUrl && <meta property="og:url" content={ogUrl} />}
        <meta property="og:image" content={shareImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={shareImageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={shareImage} />
        <meta name="twitter:image:alt" content={shareImageAlt} />
        <!-- Preferencias de color del agente y color de UI del navegador (Safari iOS/desktop) -->
        <meta name="color-scheme" content="light dark" />
        <!-- Fallback general -->
        <meta name="theme-color" content="#67b7f0" />
        <!-- Variantes por esquema de color (iOS 15+ soporta theme-color) -->
        <meta name="theme-color" media="(prefers-color-scheme: light)" content="#67b7f0" />
        <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#67b7f0" />
        <!-- PWA en iOS (al añadir a la pantalla de inicio) -->
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <!-- Recomendado: equivalente genérico para Android/Chrome -->
        <meta name="mobile-web-app-capable" content="yes" />
        <!-- black-translucent permite que el fondo de la página se vea detrás de la barra de estado -->
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
        {/* Sin preconnect a Strapi: los medios del CMS salen por /media en este
            mismo dominio (nginx.conf), así que el navegador abría una conexión
            a strapi.minkayni.org que nunca usaba y Lighthouse lo señalaba. */}

        {/* Decisiones que hay que tomar ANTES del primer pintado, para que el
             HTML no esconda nada «por si acaso»:

             - `data-js`: hay JavaScript. Las reglas que ocultan algo hasta que
               una animación lo revele cuelgan de este atributo, así que sin
               JS (o si el bundle no llega) el contenido y el menú se ven tal
               cual vienen en el HTML. Es lo que exige la política de sitios
               de Ad Grants y lo que un rastreador necesita.
             - `data-low-power`: equipo lento; los fondos animados (Hero) se
               degradan sin parpadeo.
             - `data-intro="pending"`: solo en la portada, y solo cuando la
               intro va a reproducirse de verdad (visita nueva, sin
               `prefers-reduced-motion`, sin ahorro de datos ni red lenta, sin
               ancla en la URL, y sin robots: buscadores y medidores como
               PageSpeed/Lighthouse reciben la portada directamente; la nota
               de laboratorio sale sin la intro, los datos de visitantes reales
               de Chrome no). Es la misma regla que aplica `intro.ts`; se
               decide aquí para que quien NO va a ver la intro reciba la
               portada pintada desde el primer cuadro en vez de una pantalla
               en blanco hasta que carga el script. */}
        <script is:inline define:vars={{ intro, clave: CLAVE_VISITA, caducidad: CADUCIDAD_VISITA_MS }}>
            try {
                var html = document.documentElement;
                var n = navigator;
                var c = n.connection;
                html.setAttribute("data-js", "");
                var low = (n.hardwareConcurrency && n.hardwareConcurrency <= 2) || (n.deviceMemory && n.deviceMemory <= 2) || (c && c.saveData === true);
                if (low) html.setAttribute("data-low-power", "");
                if (intro) {
                    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                    var lenta = !!(c && (c.saveData === true || /(^|[^4-9])[23]g$/.test(String(c.effectiveType || ""))));
                    var nueva = true;
                    try {
                        var sello = Number(localStorage.getItem(clave));
                        nueva = !(sello > 0) || Date.now() - sello >= caducidad;
                    } catch (e) {
                        /* Sin almacenamiento no hay memoria: ante la duda, la intro se ve. */
                    }
                    /* Cualquier visita automatizada: navegadores controlados por
                       código (`webdriver`: Selenium, Puppeteer, Playwright) y
                       todo lo que se anuncie como robot, medidor o
                       revisor. «CUBOT» es una marca de móviles, no un robot. */
                    var ua = n.userAgent || "";
                    var robot =
                        n.webdriver === true ||
                        (/bot|crawl|spider|slurp|scrap|headless|lighthouse|pagespeed|inspectiontool|preview|screenshot|prerender|render|phantom|puppeteer|playwright|selenium|validator|checker|monitor|uptime|pingdom|gtmetrix|facebookexternalhit|embedly|python|curl|wget|httpclient|okhttp|java\/|go-http|axios|node-fetch/i.test(ua) &&
                            !/cubot/i.test(ua));
                    if (nueva && !reduce && !lenta && !low && !robot && !location.hash) html.setAttribute("data-intro", "pending");
                }
            } catch (e) {}
        </script>

        <title>{fullTitle}</title>

        <!-- Identidad legal de la organización (schema.org/NGO) -->
        <OrganizationJsonLd />
        <!-- Sitio y ruta de navegación (WebSite + BreadcrumbList) -->
        <PageJsonLd title={title} noindex={noindex} />
        <style>
            body[data-grain="off"] #grain-layer {
                display: none;
            }
            html.no-scroll,
            body.no-scroll {
                overflow: hidden !important;
                height: 100%;
                overscroll-behavior: none;
                touch-action: none;
            }
        </style>
        <style is:global>
            @media (max-width: 768px) {
                nav.page-nav {
                    display: none !important;
                    visibility: hidden !important;
                    pointer-events: none !important;
                    height: 0 !important;
                    overflow: hidden !important;
                }
            }
            /* Ocultar COMPLETAMENTE el PageNavigation durante la intro */
            html.no-scroll nav.page-nav,
            body[data-intro="pending"] nav.page-nav {
                opacity: 0 !important;
                visibility: hidden !important;
                pointer-events: none !important;
                transform: translateY(16px);
            }
        </style>
        {/* Cortina entre páginas: si se llegó desde otra página del sitio, tapar
            antes del primer pintado. Ver PixelCurtain.tsx y global.css. */}
        <script is:inline>
            try {
                if (sessionStorage.getItem("pixel-curtain") === "1") document.documentElement.dataset.curtain = "covered";
            } catch (e) {}
        </script>
        {/* `trasLcp(fn)`: ejecuta fn cuando Chrome ya ha anotado el LCP del
            cuadro que lleva la página entera. Lo usan las fuentes
            (FontFaces.astro) y Google Analytics (Analytics.astro): las dos
            cosas pesan, ninguna hace falta para ver la página, y el modelo de
            PageSpeed suma al LCP todo lo que se pida antes de que se anote.

            Declararlas «un cuadro después de parsear el documento» no
            bastaba: el LCP se anota con la hora en que el cuadro llega a la
            pantalla, que puede caer unos milisegundos después. En una pasada
            las fuentes salieron a los 1475 ms, el LCP se anotó a los 1480, y
            PageSpeed cargó el LCP con ~250 KB (2,0 → 5,3 s).

            Así que se espera a que el PerformanceObserver entregue una entrada
            de LCP de ese cuadro o de uno posterior; si en dos cuadros no llega
            ninguna, el elemento más grande ya estaba pintado y el LCP está
            cerrado. Sin LCP (Safari, Firefox): un cuadro después. Y un plazo
            de seguridad por si la pestaña está oculta y no hay cuadros. */}
        <script is:inline>
            window.trasLcp = (function () {
                var cola = [];
                var hecho = false;
                var arrancado = false;
                var ejecutar = function () {
                    if (hecho) return;
                    hecho = true;
                    for (var i = 0; i < cola.length; i++) {
                        try {
                            cola[i]();
                        } catch (e) {}
                    }
                    cola = [];
                };
                var tipos = (window.PerformanceObserver && PerformanceObserver.supportedEntryTypes) || [];
                var conLcp = tipos.indexOf("largest-contentful-paint") !== -1;
                var arrancar = function () {
                    if (arrancado) return;
                    arrancado = true;
                    if (!conLcp) {
                        requestAnimationFrame(function () {
                            setTimeout(ejecutar, 0);
                        });
                        return;
                    }
                    requestAnimationFrame(function (desde) {
                        var obs = new PerformanceObserver(function (lista) {
                            var entradas = lista.getEntries();
                            for (var i = 0; i < entradas.length; i++) {
                                if (entradas[i].startTime >= desde - 1) {
                                    obs.disconnect();
                                    setTimeout(ejecutar, 0);
                                    return;
                                }
                            }
                        });
                        obs.observe({ type: "largest-contentful-paint", buffered: true });
                        requestAnimationFrame(function () {
                            requestAnimationFrame(function () {
                                setTimeout(function () {
                                    obs.disconnect();
                                    ejecutar();
                                }, 50);
                            });
                        });
                    });
                };
                if (document.readyState !== "loading") arrancar();
                else
                    document.addEventListener("readystatechange", function () {
                        if (document.readyState !== "loading") arrancar();
                    });
                setTimeout(ejecutar, 3000);
                return function (fn) {
                    if (hecho) setTimeout(fn, 0);
                    else cola.push(fn);
                };
            })();
            /* Imágenes que no hacen falta para la primera pantalla —carrusel
               de momentos, fotos del equipo y de los testimonios, portadas de
               los reels, el vídeo del grano— llevan la URL en `data-lcp-src`
               / `data-lcp-srcset` / `data-lcp-poster` / `data-lcp-href` (la
               <image> de SVG) y se piden aquí, ya anotado el LCP. `loading="lazy"` no lo
               conseguía: en 4G lenta Chrome adelanta 2500 px y pedía ~340 KB
               antes del texto de portada. */
            window.trasLcp(function () {
                var pasar = function (nodo, dato, atributo) {
                    var valor = nodo.getAttribute(dato);
                    if (valor === null) return;
                    nodo.removeAttribute(dato);
                    nodo.setAttribute(atributo, valor);
                };
                var soltar = function () {
                    var nodos = document.querySelectorAll("[data-lcp-src],[data-lcp-srcset],[data-lcp-poster],[data-lcp-href]");
                    for (var i = 0; i < nodos.length; i++) {
                        pasar(nodos[i], "data-lcp-srcset", "srcset");
                        pasar(nodos[i], "data-lcp-src", "src");
                        pasar(nodos[i], "data-lcp-poster", "poster");
                        pasar(nodos[i], "data-lcp-href", "href");
                    }
                };
                /* El plazo de seguridad de `trasLcp` puede vencer con el
                   documento a medio parsear: entonces se espera a tenerlo
                   entero, o las imágenes de más abajo se quedarían sin URL. */
                if (document.readyState !== "loading") soltar();
                else
                    document.addEventListener("readystatechange", function () {
                        if (document.readyState !== "loading") soltar();
                    });
            });
        </script>
        <Analytics />
    </head>
    <body class="bg-background text-black">
        {/* El aviso de cookies va al PRINCIPIO del cuerpo, no al final. Es
            `position: fixed`, así que se ve igual; lo que cambia es cuándo se
            pinta. Al final del documento se pintaba el último, cuando ya
            estaba todo lo demás, y su texto es lo bastante grande como para
            que Chrome lo tomara a veces por el LCP: un LCP tardío al que
            PageSpeed sumaba todo lo pedido antes (fuentes, scripts, fotos del
            carrusel), 6,3 s en una pasada. Aquí se pinta con el primer cuadro
            y el LCP vuelve a ser la leyenda de la portada. Para un lector de
            pantalla, además, un aviso que pide una decisión va antes del
            contenido. */}
        <CookieConsent />
        <slot />
        {/* @font-face de las fuentes propias, declaradas con el documento ya
            parseado (ver el componente). Va al final: en el <head> eran 7 KB
            de script delante de todo el contenido. */}
        <FontFaces />
    </body>
</html>
