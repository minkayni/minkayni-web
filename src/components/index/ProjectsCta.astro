---
import SectionHeading from "../SectionHeading.astro";
import SectionIsland from "../SectionIsland.astro";
/* CTA de la portada hacia /projects: cierra la narrativa del proyecto
   destacado invitando a explorar el ecosistema completo.
   Contenido editable desde Strapi (homepage → projectsCta*). */
import Button from "../Button.astro";
import { projectsCtaFallback } from "../../data/pages/global";
import { withFallback } from "../../utils/content";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

interface Props {
    /** `false` cuando otra sección viene detrás y pone ella el margen al pie. */
    last?: boolean;
    content?: {
        heading?: { eyebrow?: string | null; title?: string | null; body?: string | null } | null;
        tags?: Array<{ text?: string | null } | null> | null;
        button?: { href?: string | null; defaultText?: string | null; hoverText?: string | null } | null;
    } | null;
}

const { content, last = true } = Astro.props;
const d = withFallback(projectsCtaFallback, content);
const tags = d.tags.filter((tag) => tag?.text);
const exploreHref = d.button.href || "/projects";
---

<SectionIsland
    tone="accent"
    padding="none"
    class:list={[
        "mt-16 overflow-hidden px-6 py-14 sm:px-12 md:mt-24 lg:px-20 lg:py-20",
        /* El margen inferior grande deja sitio al arco del pie. Cuando otra
           sección cierra la página (HelpCta), ese aire lo pone ella. */
        last ? "mb-44 md:mb-80" : "mb-0",
    ]}
    aria-labelledby="projects-cta-title"
>
    <div class="mx-auto flex max-w-[900px] flex-col items-center text-center">
        <SectionHeading id="projects-cta-title" eyebrow={d.heading.eyebrow} title={d.heading.title} accent="text-primary" class="title text-5xl leading-[0.95] sm:text-7xl" />
        <p class="mt-6 max-w-[58ch] text-lg leading-[1.55] text-black/75">{d.heading.body}</p>
        {
            tags.length > 0 && (
                <ul class="mt-8 flex flex-wrap justify-center gap-2" aria-label={t("home.linesOfAction")}>
                    {tags.map((tag) => (
                        <li>
                            <a
                                href={`${exploreHref.split("#")[0]}#project-explorer`}
                                class="inline-flex rounded-full bg-black/10 px-4 py-2 text-sm font-bold spring press hover:-translate-y-0.5 hover:bg-primary hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                            >
                                {tag.text}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
        <div class="mt-10">
            <Button href={d.button.href} defaultText={d.button.defaultText} hoverText={d.button.hoverText} />
        </div>
    </div>
</SectionIsland>
