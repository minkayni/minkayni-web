---
/* Sección "Proyecto destacado" de la portada.
   Contenido editable desde Strapi (homepage → featuredProject).
   El logo de Batucada va GRANDE sobre la foto (como el diseño original);
   el panel desarrolla el concepto: titular, prosa normalizada con el resto
   del sitio (text-lg leading-[1.55], el mismo ritmo que el resto de
   párrafos de la portada), mini-cifras y botón. */
import type { ImageMetadata } from "astro";
import BatucadaLogo from "../../assets/SVG/LOGO_BATUCADA_2025.svg";
import BatucadaPhoto from "../../assets/FOTO_BATUCADA.webp";
import flor from "../../assets/SVG/misc/flor.svg";
import { Image } from "astro:assets";
import Button from "../Button.astro";
import CmsImage from "../CmsImage.astro";
import type { CmsMedia } from "../../data/pages/types";
import { featuredProjectFallback } from "../../data/pages/global";
import { withFallback } from "../../utils/content";
import { formatTitle, splitParagraphs } from "../../utils/rich-title";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

interface Props {
    logoSrc?: ImageMetadata;
    photoSrc?: ImageMetadata;
    /** Contenido del componente sections.featured-project (homepage en Strapi) */
    content?: {
        title?: string | null;
        headline?: string | null;
        body?: string | null;
        logo?: CmsMedia;
        photo?: CmsMedia;
        button?: { href?: string | null; defaultText?: string | null; hoverText?: string | null } | null;
        stats?: Array<{ value?: string | null; label?: string | null } | null> | null;
    } | null;
}

const { logoSrc = BatucadaLogo, photoSrc = BatucadaPhoto, content } = Astro.props as Props;
const d = withFallback({ ...featuredProjectFallback, logo: null as CmsMedia, photo: null as CmsMedia }, content);
const bodyParagraphs = splitParagraphs(d.body ?? "");
const stats = (d.stats ?? []).filter((stat) => stat?.value && stat?.label);
---

<section id="featured-project" class="relative mt-16 w-full md:mt-24">
    <div class="grid overflow-hidden rounded-t-[50px] bg-[linear-gradient(135deg,#4a0073_0%,var(--primary)_65%,#4a0073_100%)] md:rounded-t-[100px] lg:grid-cols-[1.05fr_0.95fr]">
        <!-- Foto con el logo protagonista encima -->
        <figure class="featured-img-col relative min-h-[420px] overflow-hidden sm:min-h-[520px] lg:min-h-svh">
            <CmsImage
                media={d.photo}
                fallback={photoSrc}
                alt={t("alt.batucadaIntervention")}
                class="batucada-photo absolute inset-0 h-full w-full object-cover object-center"
                widths={[720, 1280, 1920]}
                sizes="(min-width: 64em) 55vw, 100vw"
            />
            <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(20,0,35,0.45)_0%,rgba(20,0,35,0.15)_60%,rgba(56,0,88,0.35)_100%)]" aria-hidden="true"></div>
            <div class="wordmark-parallax absolute inset-0 flex items-center justify-center p-8">
                <CmsImage
                    media={d.logo}
                    fallback={logoSrc}
                    alt="Batucada Popular"
                    class="batucada-wordmark h-auto w-[62%] max-w-[300px] select-none drop-shadow-[0_10px_40px_rgba(0,0,0,0.6)] sm:max-w-[380px] lg:max-w-[440px]"
                    widths={[440, 880]}
                />
            </div>
        </figure>

        <!-- Panel -->
        <div id="featured-project-panel" class="relative flex flex-col justify-center overflow-hidden p-8 text-white sm:p-12 lg:p-16 xl:px-24">
            <Image src={flor} alt="" class="pointer-events-none absolute -bottom-16 -right-14 h-64 w-64 rotate-12 opacity-10" aria-hidden="true" />

            <div class="relative flex flex-col items-start gap-7">
                <p class="featured-title flex items-center gap-3 text-sm font-bold uppercase tracking-[0.26em] text-secondary-light">
                    <span class="h-[3px] w-8 rounded-full bg-secondary" aria-hidden="true"></span>
                    {d.title}
                </p>

                {d.headline && <h2 data-scroll-float class="featured-headline max-w-[16ch] font-display text-4xl font-black leading-[0.95] sm:text-5xl xl:text-6xl" set:html={formatTitle(d.headline, "text-secondary")} />}

                <div class="featured-body flex max-w-[58ch] flex-col gap-4 text-lg leading-[1.55] text-white/85">
                    {bodyParagraphs.map((paragraph) => <p>{paragraph}</p>)}
                </div>

                {
                    stats.length > 0 && (
                        <dl class="flex flex-wrap gap-x-10 gap-y-4 border-t border-white/15 pt-6">
                            {stats.map((stat) => (
                                <div>
                                    <dt class="sr-only">{stat.label}</dt>
                                    <dd class="font-display text-3xl font-black text-secondary sm:text-4xl">{stat.value}</dd>
                                    <dd class="mt-1 text-xs font-bold uppercase tracking-[0.18em] text-white/60">{stat.label}</dd>
                                </div>
                            ))}
                        </dl>
                    )
                }

                <div class="pt-2">
                    <Button href={d.button.href} defaultText={d.button.defaultText} hoverText={d.button.hoverText} />
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap, SplitText, waitForFontsReady } from "../../scripts/main.ts";
    import { CARTOON, SMOOTH } from "../../scripts/spring";

    const initFeaturedProject = () => {
        const section = document.getElementById("featured-project");
        if (!section || section.dataset.fpReady === "true") return;
        section.dataset.fpReady = "true";

        const photo = section.querySelector(".batucada-photo");
        const wordmark = section.querySelector(".batucada-wordmark");
        const eyebrow = section.querySelector<HTMLElement>(".featured-title");
        const headline = section.querySelector<HTMLElement>(".featured-headline");
        const body = section.querySelector<HTMLElement>(".featured-body");
        const button = section.querySelector("[data-magic-btn]");
        const animated = [photo, wordmark, eyebrow, headline, body, button].filter(Boolean);

        if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
            gsap.set(animated, { clearProps: "all" });
            return;
        }

        waitForFontsReady(() => {
            let headlineSplit: SplitText | undefined;
            let bodySplit: SplitText | undefined;
            try {
                if (headline) headlineSplit = new SplitText(headline, { type: "words,chars", wordsClass: "word", charsClass: "char" });
                /* Se divide cada <p> por separado, no el contenedor: con
                   `type: "lines"` sobre el contenedor, SplitText saca las
                   líneas al primer nivel y cada una hereda el `gap` del flex
                   destinado a separar párrafos (28px de línea + 16px de gap).

                   `autoSplit` vuelve a dividir cuando cambia el ancho: sin él,
                   las líneas se calculan antes de que el panel llegue a su
                   tamaño final y el texto sobrante de cada una cae a una
                   segunda línea dentro del mismo div, dejando palabras sueltas. */
                const bodyParagraphs = body?.querySelectorAll("p");
                if (bodyParagraphs?.length) {
                    bodySplit = SplitText.create(bodyParagraphs, {
                        type: "lines",
                        linesClass: "line",
                        autoSplit: true,
                        /* Por defecto SplitText copia el texto a un `aria-label`
                           del elemento partido; en un <p> ese atributo está
                           prohibido por ARIA y Lighthouse lo marca. Las líneas
                           son <div> con el texto tal cual, así que el lector de
                           pantalla lo lee seguido sin ayuda. */
                        aria: "none",
                        onSplit: (self) =>
                            gsap.from(self.lines, {
                                yPercent: 40,
                                opacity: 0,
                                stagger: 0.07,
                                ...CARTOON,
                                scrollTrigger: {
                                    trigger: section,
                                    start: "top 75%",
                                    toggleActions: "play none none reverse",
                                },
                            }),
                    });
                }

                const timeline = gsap.timeline({
                    defaults: { ease: CARTOON.ease },
                    scrollTrigger: {
                        trigger: section,
                        start: "top 75%",
                        toggleActions: "play none none reverse",
                    },
                });

                timeline
                    /* La foto llena su marco: con rebote bajaría de escala 1 y asomarían los bordes. */
                    .from(photo, { scale: 1.15, ...SMOOTH }, 0)
                    .from(wordmark, { yPercent: -10, rotate: -2, opacity: 0, duration: CARTOON.duration }, 0.2)
                    .from(eyebrow, { y: 24, opacity: 0, duration: CARTOON.duration }, 0.15);

                if (headlineSplit?.chars.length) timeline.from(headlineSplit.chars, { yPercent: 120, opacity: 0, stagger: { each: 0.02, from: "center" }, duration: CARTOON.duration }, 0.25);
                if (button) timeline.from(button, { y: 30, opacity: 0, duration: CARTOON.duration }, 0.6);

                const revealFallback = window.setTimeout(() => gsap.set(animated, { clearProps: "opacity,visibility" }), 1800);
                window.addEventListener("pagehide", () => {
                    window.clearTimeout(revealFallback);
                    timeline.kill();
                    headlineSplit?.revert();
                    bodySplit?.revert();
                }, { once: true });
            } catch {
                gsap.set(animated, { clearProps: "all" });
                headlineSplit?.revert();
                bodySplit?.revert();
            }
        });
    };

    /* La sección está bastante más abajo que la primera pantalla: partir el
       titular y los párrafos con SplitText y medir la línea de tiempo se
       hace cuando se acerca (dos pantallas antes), no en el arranque. Hasta
       entonces la sección se ve tal cual; los `from` la esconden y la
       revelan cuando entra, igual que antes. */
    const preparar = () => {
        const section = document.getElementById("featured-project");
        if (!section) return;
        if (!("IntersectionObserver" in window)) {
            initFeaturedProject();
            return;
        }
        const obs = new IntersectionObserver(
            (entries) => {
                if (!entries.some((e) => e.isIntersecting)) return;
                obs.disconnect();
                initFeaturedProject();
            },
            { rootMargin: "200% 0px 200% 0px" }
        );
        obs.observe(section);
    };
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", preparar, { once: true });
    else preparar();
</script>
