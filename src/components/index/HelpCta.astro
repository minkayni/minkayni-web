---
/* ──────────────────────────────────────────────────────────────────────────
   «Cómo puedes ayudar» — cierre de la portada.

   Tres puertas de entrada, cada una con su destino real: aportar (/donate),
   sumarse (el formulario de contacto de Conócenos) y aliarse (mismo
   contacto). Existe porque la portada no enlazaba a la página de aportes por
   ningún sitio y la revisión de Ad Grants pidió llamadas a la acción claras.

   Misma gramática visual que el resto de la portada: isla redondeada al 94 %
   de ancho, eyebrow en versalitas, titular Aristotelica con una palabra en
   color, tarjetas con esquinas de 1,75 rem y el mismo foco visible que las
   tarjetas del 404. Nada de esto depende de JavaScript ni del CMS.
─────────────────────────────────────────────────────────────────────────── */
import { Icon } from "astro-icon/components";
import { getLocale, localizePath, useTranslations } from "../../i18n";
import { globalFallback } from "../../data/pages/global";
import { formatTitle } from "../../utils/rich-title";

interface Props {
    /** Correo de contacto (single type `global` del CMS). */
    contactEmail?: string | null;
    /** Enlace de WhatsApp (single type `global` del CMS). */
    whatsappUrl?: string | null;
}

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const { contactEmail = globalFallback.contactEmail, whatsappUrl = globalFallback.whatsappUrl } = Astro.props;

const cards = [
    {
        icon: "mdi:heart-outline",
        title: t("help.donateTitle"),
        text: t("help.donateText"),
        link: t("help.donateLink"),
        href: localizePath("/donate", locale),
        tone: "bg-primary text-white",
        linkTone: "text-white",
        iconTone: "bg-white/15 text-white",
    },
    {
        icon: "mdi:hand-heart-outline",
        title: t("help.volunteerTitle"),
        text: t("help.volunteerText"),
        link: t("help.volunteerLink"),
        href: localizePath("/about#contacto", locale),
        tone: "bg-secondary text-black",
        linkTone: "text-black",
        iconTone: "bg-black/10 text-black",
    },
    {
        icon: "mdi:handshake-outline",
        title: t("help.partnerTitle"),
        text: t("help.partnerText"),
        link: t("help.partnerLink"),
        href: localizePath("/about#contacto", locale),
        tone: "bg-accent text-black",
        linkTone: "text-black",
        iconTone: "bg-black/10 text-black",
    },
];
---

<section id="ayuda" class="mx-auto mb-44 mt-16 w-[94%] max-w-[1440px] md:mb-80 md:mt-24" aria-labelledby="help-title">
    <div class="rounded-[2.75rem] bg-white/60 px-6 py-14 sm:px-12 lg:rounded-[5rem] lg:px-20 lg:py-20">
        <div class="max-w-[760px]">
            <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-primary">{t("help.eyebrow")}</p>
            <h2 data-scroll-float id="help-title" class="font-display text-5xl font-black leading-[0.95] text-black sm:text-7xl" set:html={formatTitle(t("help.title"), "text-primary")} />
            <p class="mt-6 max-w-[60ch] text-lg leading-[1.55] text-black/70">{t("help.body")}</p>
        </div>

        <ul class="mt-12 grid list-none gap-5 p-0 md:grid-cols-3">
            {
                cards.map((card) => (
                    <li class="flex">
                        <a
                            href={card.href}
                            class={`group flex w-full flex-col gap-5 rounded-[1.75rem] p-7 spring hover:-translate-y-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary ${card.tone}`}
                        >
                            <span class={`inline-flex h-12 w-12 items-center justify-center rounded-full ${card.iconTone}`} aria-hidden="true">
                                <Icon name={card.icon} class="h-6 w-6" />
                            </span>
                            <span class="font-display text-2xl font-black leading-tight">{card.title}</span>
                            <span class="text-base leading-relaxed opacity-85">{card.text}</span>
                            <span class={`mt-auto inline-flex items-center gap-2 font-display text-lg font-bold underline underline-offset-4 ${card.linkTone}`}>
                                {card.link}
                                <span class="spring group-hover:translate-x-1" aria-hidden="true">
                                    →
                                </span>
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>

        <p class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-base text-black/70">
            <span>{t("help.contactNote")}</span>
            {
                whatsappUrl && (
                    <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 font-display font-bold text-primary underline underline-offset-4 hover:text-secondary-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                        <Icon name="mdi:whatsapp" class="h-5 w-5" aria-hidden="true" />
                        {t("help.whatsapp")}
                    </a>
                )
            }
            {
                contactEmail && (
                    <a href={`mailto:${contactEmail}`} class="inline-flex items-center gap-2 font-display font-bold text-primary underline underline-offset-4 hover:text-secondary-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                        <Icon name="mdi:email-outline" class="h-5 w-5" aria-hidden="true" />
                        {contactEmail}
                    </a>
                )
            }
        </p>
    </div>
</section>
