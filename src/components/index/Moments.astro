---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import reelIcon from "../../assets/icons/reel.png";
import { PIXEL, strapiMediaSrcSet, strapiMediaUrl } from "../../utils/media-url";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
/* Los pies de foto llegan tal cual de las redes, en español: fuera de la
   versión española se marcan con `lang` para que lectores de pantalla y
   traductores del navegador los lean como lo que son. Traducirlos a mano no
   sirve, porque la sincronización los reescribe. */
const captionLang = getLocale(Astro.url) === "es" ? undefined : "es";

const STRAPI_URL = import.meta.env.STRAPI_URL ?? "";
const posts = await getCollection("posts");

type Media = { url?: string | null; mime?: string | null } | null | undefined;

/* Vídeo o imagen se decide por el archivo, no por `media_kind`: un reel cuya
   música tiene derechos llega sin vídeo (Meta no lo entrega), y lo que queda
   es su portada. Antes eso acababa en un <video> con un JPEG dentro. */
const isVideo = (file: Media) => Boolean(file?.url) && (file?.mime ? file.mime.startsWith("video/") : /\.(webm|mp4|mov)$/i.test(file?.url ?? ""));
const pickMedia = (post: { source?: Media; poster?: Media }) => {
    const video = isVideo(post.source) ? post.source : null;
    const image = post.poster?.url ? post.poster : post.source?.url && !video ? post.source : null;
    return { video, image };
};

/* Solo las más recientes: cada tarjeta pesa ~3 KB de HTML y la portada tiene
   un presupuesto (tests/ad-grants.test.ts). El archivo completo vive en
   /novedades. Doce bastan para que el carrusel en bucle llene cualquier pantalla. */
const MAX_POSTS = 12;
const postedAt = (value: unknown) => (typeof value === "string" ? Date.parse(value) || 0 : 0);

const items = posts
    .filter(({ data }) => {
        const { video, image } = pickMedia(data);
        return Boolean(video || image);
    })
    .sort((a, b) => postedAt(b.data.posted_at) - postedAt(a.data.posted_at))
    .slice(0, MAX_POSTS);
---

<div class="bg-primary w-full">
    <div class="wrapper h-[250px] md:h-[500px] relative flex items-center overflow-hidden gap-6">
        {
            items.length === 0 ? (
                <div class="text-white opacity-70 w-full flex items-center justify-center text-center">{t("empty.posts")}</div>
            ) : (
                items.map(({ data: post }) => {
                    const { video, image } = pickMedia(post);
                    const mediaUrl = strapiMediaUrl(image?.url, STRAPI_URL, 960);
                    const mediaSrcSet = strapiMediaSrcSet(image?.url, STRAPI_URL, [320, 640, 960]);
                    /* Portada del reel: la miniatura de Meta o un fotograma que
                       el CMS saca al transcodificar, servida por Imagor en WebP
                       a 640 px. Es lo que se ve mientras el vídeo no se
                       reproduce, y lo único que se ve donde el navegador no
                       lee WebM (Safari de iPhone anterior a iOS 17.4). */
                    const posterUrl = image?.url ? strapiMediaUrl(image.url, STRAPI_URL, 640) : undefined;
                    const videoType = video && (video.mime === "video/webm" || /\.webm$/i.test(video.url ?? "")) ? 'video/webm; codecs="vp9"' : (video?.mime ?? undefined);
                    return (
                    <div class="post-card group aspect-[1/1] h-full flex-shrink-0 rounded-lg overflow-hidden relative shadow-lg" data-id={post.external_id}>
                        <div class="relative w-full h-full">
                            {/* Media: fondo (solo el fondo escala en hover del grupo) */}
                            {video || image ? (
                                video ? (
                                    <video
                                        class="media object-cover w-full h-full absolute inset-0 -z-10 pointer-events-none transition-transform duration-300 transform-gpu origin-center group-hover:scale-105"
                                        data-src={strapiMediaUrl(video.url, STRAPI_URL)}
                                        data-type={videoType}
                                        data-lcp-poster={posterUrl || undefined}
                                        preload="none"
                                        muted
                                        loop
                                        playsinline
                                        disablepictureinpicture
                                        disableRemotePlayback
                                        aria-label={post.caption || `Reel ${post.external_id}`}
                                        lang={post.caption ? captionLang : undefined}
                                    />
                                ) : (
                                    <img
                                        class="media object-cover w-full h-full absolute inset-0 -z-10 transition-transform duration-300 transform-gpu origin-center group-hover:scale-105"
                                        src={PIXEL}
                                        data-lcp-src={mediaUrl}
                                        data-lcp-srcset={mediaSrcSet || undefined}
                                        sizes="(min-width: 768px) 400px, 200px"
                                        alt={post.caption || t("news.postFallback", { id: post.external_id ?? "" })}
                                        lang={post.caption ? captionLang : undefined}
                                        width="960"
                                        height="960"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                )
                            ) : null}

                            <div class="group-hover:opacity-100 group-focus-within:opacity-100 opacity-0 transition-opacity duration-300">
                                {/* Top bar: icono (izq) y permalink (der) en el mismo div */}
                                <div class="absolute left-3 right-3 top-3 z-20 flex items-center justify-between pointer-events-auto p-2">
                                    <div class="flex items-center">{post.media_kind === "reel" ? <Image src={reelIcon} alt={t("alt.reel")} class="w-8 h-8 object-contain drop-shadow-md invert" /> : <Icon name="mdi:images" class="w-6 h-6 text-white drop-shadow-md" />}</div>
                                    <div>
                                        <a href={post.permalink} target="_blank" rel="noopener noreferrer" aria-label={t("news.openPost")} class="inline-flex items-center justify-center p-1.5 rounded bg-black/40 hover:bg-black/60">
                                            <Icon name="mdi:external-link" class="w-5 h-5 text-white" />
                                        </a>
                                    </div>
                                </div>

                                {/* Caption: ocupa 20% height y queda abajo; ellipsis si es largo */}
                                <div class="absolute left-0 right-0 bottom-0 h-[50%] flex items-end z-20">
                                    <div class="w-full h-fit p-3 bg-gradient-to-t from-black/90 to-transparent">
                                        <p class="text-base text-white leading-tight overflow-hidden line-clamp-4 m-2" lang={captionLang}>{post.caption}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    );
                })
            )
        }
    </div>
</div>

<style>
    .post-card {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 80%;
        aspect-ratio: 1/1;
        margin: 0;
        padding: 0;
        position: relative;
        flex-shrink: 0;
        color: black;
        font-size: 21px;
        border-radius: 10%;
        overflow: hidden;
    }
</style>

<script>
    import { init } from "./momentsInit";

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
    } else {
        init();
    }
</script>
