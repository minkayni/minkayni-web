---
/* Página de una actividad de campo: /novedades/<slug> y /en/news/<slug>.

   Los bloques del cuerpo son los del constructor (los mismos componentes que
   las subpáginas y que la vista previa del panel), pintados a HTML estático
   en su variante de artículo: llenan la columna de lectura en vez de poner
   su propio ancho. Galería, redes y botones de compartir viven en sus
   propios componentes. */
import PageLayout from "../../layouts/PageLayout.astro";
import BuilderBlocks, { READING } from "../react/builder/BuilderBlocks";
import { blockImageUrls, normalizeBlocks, renderBlocksMarkdown } from "../react/builder/normalize";
import { Icon } from "astro-icon/components";
import ActividadCard from "./ActividadCard.astro";
import ActividadCompartir from "./ActividadCompartir.astro";
import ActividadGaleria from "./ActividadGaleria.astro";
import ActividadRedes from "./ActividadRedes.astro";
import { renderMarkdown } from "../../utils/render-markdown";
import { blockLabels } from "../../utils/block-labels";
import { cmsPhotos } from "../../utils/sector-photos";
import { viewerStrings } from "../../utils/viewer-strings";
import { strapiMediaUrl } from "../../utils/media-url";
import { enlaceMapa, esImagen, imagenDe, type ActividadResumen } from "../../utils/actividades-core";
import { localizePath, useTranslations, type Locale } from "../../i18n";
import type { Activity } from "../../schemas/pages.zod";

interface Vecina {
    slug: string;
    titulo: string;
}

interface Props {
    actividad: Activity;
    resumen: ActividadResumen;
    locale: Locale;
    anterior?: Vecina;
    siguiente?: Vecina;
    /** Otras actividades para «Más actividades», ya elegidas. */
    relacionadas?: ActividadResumen[];
}

const { actividad, resumen, locale, anterior, siguiente, relacionadas = [] } = Astro.props;
const t = useTranslations(locale);
const STRAPI_URL = (import.meta.env.STRAPI_URL ?? "").trim();

const blocks = await renderBlocksMarkdown(normalizeBlocks(actividad.sections), renderMarkdown);

const portada = imagenDe(actividad.cover, STRAPI_URL, resumen.titulo, [640, 1080, 1600, 2200]);
/* La galería del final no repite lo que ya se vio arriba (portada y fotos del
   cuerpo): solo trae las demás. Si el cuerpo ya las usa todas, no sale. */
const yaVistas = new Set([actividad.cover?.url, ...blockImageUrls(blocks)].filter(Boolean));
const galeriaCompleta = (actividad.gallery ?? []).filter(esImagen);
const galeria = galeriaCompleta.filter((foto) => !yaVistas.has(foto?.url));
const fotos = cmsPhotos(galeria, STRAPI_URL, resumen.titulo, 40);
const conGaleria = fotos.length > 1;
/* Sin galería al final (el cuerpo ya las usa todas), «9 fotos» abre el visor
   con todas, en vez de quedarse en un dato muerto. */
const todasLasFotos = conGaleria ? [] : cmsPhotos(galeriaCompleta, STRAPI_URL, resumen.titulo, 40);
const soloRestantes = galeria.length < galeriaCompleta.length;
const videos = [actividad.video, ...(actividad.gallery ?? [])]
    .filter((m, i, lista) => m?.url && m.mime?.startsWith("video/") && lista.findIndex((x) => x?.url === m.url) === i)
    .map((m) => strapiMediaUrl(m?.url, STRAPI_URL))
    .filter(Boolean);
const mapa = enlaceMapa(actividad.lat, actividad.lng);
const vecinas = [
    { vecina: anterior, etiqueta: t("news.previous"), icono: "mdi:arrow-left", clase: "" },
    { vecina: siguiente, etiqueta: t("news.next"), icono: "mdi:arrow-right", clase: "sm:text-right sm:items-end" },
];
const marca = resumen.marca === "batucada" ? t("news.brand.batucada") : t("news.brand.minkayni");
const novedades = localizePath("/novedades/", locale);

/* Aliados de la actividad: con su logo si el CMS lo tiene, si no con el nombre.
   La propia marca no va aquí: ya firma la página. */
const LOGO_ALTO = 40;
const aliados = (actividad.partners ?? [])
    .filter((p): p is NonNullable<typeof p> & { name: string } => Boolean(p?.name?.trim()))
    .map((p) => ({
        nombre: p.name.trim(),
        rol: p.role === "financiador" ? "financiador" : "colaborador",
        url: p.url?.startsWith("https://") ? p.url : undefined,
        logo: p.logo?.url ? strapiMediaUrl(p.logo.url, STRAPI_URL, 320) : undefined,
        ancho: p.logo?.width && p.logo?.height ? Math.round((p.logo.width * LOGO_ALTO) / p.logo.height) : undefined,
    }));
const gruposAliados = [
    { titulo: t("news.factFunders"), lista: aliados.filter((a) => a.rol === "financiador") },
    { titulo: t("news.factCollaborators"), lista: aliados.filter((a) => a.rol === "colaborador") },
].filter((grupo) => grupo.lista.length > 0);
/* Para el JSON-LD: `funder` y `contributor` de schema.org, o nada si no hay. */
const organizaciones = (rol: string) => {
    const lista = aliados.filter((a) => a.rol === rol).map((a) => ({ "@type": "Organization", name: a.nombre, ...(a.url ? { url: a.url } : {}) }));
    return lista.length ? lista : undefined;
};

/* Google quiere descripciones de al menos 50 caracteres (tests/ad-grants):
   si la del CMS se queda corta se completa con la fecha, el lugar y la marca. */
const descripcionBase = actividad.seo?.metaDescription?.trim() || resumen.resumen;
const description =
    descripcionBase.length >= 50 ? descripcionBase : [descripcionBase, `${marca} · ${resumen.fechaTexto}${resumen.lugar ? ` · ${resumen.lugar}` : ""}`].filter(Boolean).join(" — ");
const url = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const jsonLd = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: resumen.titulo,
    description,
    datePublished: actividad.publishedAt ?? resumen.fechaIso,
    dateModified: actividad.updatedAt ?? undefined,
    inLanguage: locale === "es" ? "es-EC" : "en",
    url,
    image: portada ? [portada.src] : undefined,
    keywords: resumen.etiquetas.length ? resumen.etiquetas.join(", ") : undefined,
    author: { "@type": "Organization", name: "Fundación Minkayni" },
    publisher: { "@type": "Organization", name: "Fundación Minkayni" },
    funder: organizaciones("financiador"),
    contributor: organizaciones("colaborador"),
    about: {
        "@type": "Event",
        name: resumen.titulo,
        startDate: resumen.fechaIso,
        endDate: actividad.end_date ?? undefined,
        eventStatus: "https://schema.org/EventCompleted",
        location: resumen.lugar
            ? {
                  "@type": "Place",
                  name: resumen.lugar,
                  ...(mapa ? { geo: { "@type": "GeoCoordinates", latitude: actividad.lat, longitude: actividad.lng } } : {}),
              }
            : undefined,
        organizer: { "@type": "Organization", name: marca },
    },
};

const ICONO = "mt-0.5 h-5 w-5 shrink-0 text-primary";
const cuentaFotos = t("news.photoCount", { count: galeriaCompleta.length });
const ENLACE = "font-bold text-primary underline underline-offset-4 hover:text-secondary-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
---

<PageLayout title={resumen.titulo} description={description} image={portada?.src} imageAlt={portada?.alt}>
    <!-- El pie de página empieza con una cúpula (DomeSeparator) que invade
         150 px por encima (300 desde md): el padding inferior le deja sitio
         para que no tape el llamado a aportar. -->
    <article class:list={["mx-auto w-[90%] max-w-[1100px] pb-[calc(6rem+150px)] md:pb-[calc(8rem+300px)]", !portada && "pt-10"]}>
        {
            /* La portada abre la crónica: sube sobre el borde del degradado
               del hero para que la primera foto ya se vea sin desplazarse. Lo
               justo para no rozar un título de tres líneas. */
            portada && (
                <img
                    class="relative z-10 -mt-10 max-h-[78svh] w-full rounded-[2rem] bg-black/5 object-cover shadow-lg sm:rounded-[2.75rem] md:-mt-20"
                    src={portada.src}
                    srcset={portada.srcset || undefined}
                    sizes="(min-width: 1100px) 1100px, 90vw"
                    width={portada.ancho}
                    height={portada.alto}
                    alt={portada.alt}
                    fetchpriority="high"
                    decoding="async"
                />
            )
        }

        {/* Columna de lectura: la misma que el texto del cuerpo (READING en
            BuilderBlocks), centrada. Alineada a la izquierda en un contenedor
            de 1100 px dejaba vacía casi la mitad derecha de la página. */}
        <header class:list={[READING, portada && "mt-10"]}>
            <nav class="text-sm" aria-label={t("news.backToNews")}>
                <a href={novedades} class="group inline-flex items-center gap-1.5 font-bold text-primary underline-offset-4 hover:underline">
                    <Icon name="mdi:arrow-left" class="h-4 w-4 spring group-hover:-translate-x-1" aria-hidden="true" />
                    {t("news.backToNews")}
                </a>
            </nav>
            <p class="mt-8 flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-[0.18em]">
                <span class:list={["rounded-full px-3 py-1", resumen.marca === "batucada" ? "bg-accent/25 text-black" : "bg-primary/10 text-primary"]}>{marca}</span>
                {resumen.proyecto && resumen.proyecto !== marca && <span class="rounded-full bg-black/5 px-3 py-1 text-black/70">{resumen.proyecto}</span>}
            </p>
            {resumen.resumen && <p class="mt-6 text-xl leading-relaxed text-black/80 sm:text-2xl sm:leading-relaxed">{resumen.resumen}</p>}

            {/* La ficha es una línea de datos, como la firma de una crónica:
                el icono ya dice qué es cada dato y la etiqueta queda para el
                lector de pantalla. Sin rayas alrededor (la hacían parecer un
                formulario): fecha y fotos en una fila, el lugar debajo. El
                proyecto no se repite: lo dice la píldora de arriba. */}
            <dl class="mt-7 flex flex-wrap items-start gap-x-6 gap-y-2 text-base text-black/70" aria-label={t("news.factsLabel")}>
                <div>
                    <dt class="sr-only">{t("news.factDate")}</dt>
                    <dd class="flex items-start gap-2">
                        <Icon name="mdi:calendar-blank-outline" class={ICONO} aria-hidden="true" />
                        <span><time datetime={resumen.fechaIso} class="font-bold text-black">{resumen.fechaTexto}</time></span>
                    </dd>
                </div>
                {
                    galeriaCompleta.length > 1 && (
                        <div>
                            <dt class="sr-only">{t("news.factPhotos")}</dt>
                            <dd class="flex items-start gap-2">
                                <Icon name="mdi:image-multiple-outline" class={ICONO} aria-hidden="true" />
                                <span>
                                {conGaleria ? (
                                    <a href="#galeria" class={ENLACE}>
                                        {cuentaFotos}
                                    </a>
                                ) : (
                                    <>
                                        <span data-gallery-fallback>{cuentaFotos}</span>
                                        <button
                                            type="button"
                                            hidden
                                            class:list={["cursor-pointer border-0 bg-transparent p-0 text-left", ENLACE]}
                                            data-gallery={JSON.stringify(todasLasFotos)}
                                            data-gallery-strings={JSON.stringify(viewerStrings(t))}
                                            data-gallery-caption={resumen.titulo}
                                        >
                                            {cuentaFotos}
                                        </button>
                                    </>
                                )}
                                </span>
                            </dd>
                        </div>
                    )
                }
                {
                    resumen.lugar && (
                        <div class="basis-full">
                            <dt class="sr-only">{t("news.factPlace")}</dt>
                            <dd class="flex items-start gap-2">
                                <Icon name="mdi:map-marker-outline" class={ICONO} aria-hidden="true" />
                                <span>
                                    {resumen.lugar}
                                    {mapa && (
                                        <a href={mapa} target="_blank" rel="noopener noreferrer" class:list={["ml-2 text-sm", ENLACE]}>
                                            {t("news.seeOnMap")} ↗
                                        </a>
                                    )}
                                </span>
                            </dd>
                        </div>
                    )
                }
                {
                    gruposAliados.map((grupo) => (
                        <div class="mt-3 basis-full">
                            <dt class="text-sm font-bold text-black/50">{grupo.titulo}</dt>
                            <dd class="mt-2">
                                <ul class="flex list-none flex-wrap items-center gap-x-5 gap-y-3 p-0">
                                    {grupo.lista.map((a) => {
                                        const firma = a.logo ? (
                                            <img src={a.logo} alt={a.nombre} height={LOGO_ALTO} width={a.ancho} class="h-10 w-auto max-w-[9rem] object-contain" loading="lazy" decoding="async" />
                                        ) : (
                                            <span class:list={["font-bold text-black", a.url && "underline underline-offset-4"]}>{a.nombre}</span>
                                        );
                                        return (
                                            <li>
                                                {a.url ? (
                                                    <a
                                                        href={a.url}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="block rounded-md spring hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                                                        aria-label={a.nombre}
                                                    >
                                                        {firma}
                                                    </a>
                                                ) : (
                                                    firma
                                                )}
                                            </li>
                                        );
                                    })}
                                </ul>
                            </dd>
                        </div>
                    ))
                }
            </dl>
        </header>

        {
            blocks.length > 0 && (
                <div class="mt-6">
                    <BuilderBlocks blocks={blocks} strapiUrl={STRAPI_URL} variant="article" labels={blockLabels(t)} />
                </div>
            )
        }

        {/* Los temas cierran el texto en vez de abrirlo: arriba competían con
            el resumen y partían la cabecera en dos filas de píldoras. */}
        {
            resumen.etiquetas.length > 0 && (
                <ul class:list={[READING, "mt-8 flex list-none flex-wrap gap-2 p-0"]} aria-label={t("news.tags")}>
                    {resumen.etiquetas.map((etiqueta) => (
                        <li class="rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary">#{etiqueta}</li>
                    ))}
                </ul>
            )
        }

        {
            videos.length > 0 && (
                <section class="mt-16" aria-labelledby="actividad-video">
                    <h2 id="actividad-video" class="font-display text-3xl font-black leading-tight text-black sm:text-4xl">{t("news.video")}</h2>
                    <div class:list={["mt-6 grid gap-6", videos.length > 1 && "md:grid-cols-2"]}>
                        {videos.map((src) => (
                            <video class="max-h-[80svh] w-full rounded-[2rem] bg-black" src={src} controls playsinline preload="metadata" />
                        ))}
                    </div>
                </section>
            )
        }

        {conGaleria && <ActividadGaleria {fotos} titulo={resumen.titulo} {locale} restantes={soloRestantes} />}

        {/* Cierre: compartir (con los posts en redes) y de quién es la
            actividad, uno al lado del otro. Apilados eran dos tarjetas a todo
            el ancho con media tarjeta vacía cada una. */}
        <div class="mt-16 grid gap-6 lg:grid-cols-2">
            <section class="flex flex-col gap-5 rounded-3xl bg-primary/[0.06] px-6 py-8 sm:px-8" aria-labelledby="actividad-compartir">
                <h2 id="actividad-compartir" class="font-display text-2xl font-black leading-tight text-black">{t("news.shareTitle")}</h2>
                <ActividadCompartir {url} titulo={resumen.titulo} {locale} />
                <ActividadRedes {actividad} {locale} />
            </section>
            <section class="flex flex-col gap-4 rounded-3xl border border-black/10 bg-white/50 px-6 py-8 sm:px-8" aria-labelledby="actividad-sobre">
                <h2 id="actividad-sobre" class="font-display text-2xl font-black leading-tight text-black">{t(`news.aboutTitle.${resumen.marca}`)}</h2>
                <p class="text-lg leading-relaxed text-black/75">{t(`news.aboutBody.${resumen.marca}`)}</p>
                <a href={localizePath(resumen.marca === "batucada" ? "/projects/batucada-popular/" : "/about", locale)} class:list={["group mt-auto inline-flex items-center gap-1.5 self-start", ENLACE]}>
                    {t(`news.aboutLink.${resumen.marca}`)}
                    <Icon name="mdi:arrow-right" class="h-4 w-4 spring group-hover:translate-x-1" aria-hidden="true" />
                </a>
            </section>
        </div>

        {
            relacionadas.length > 0 && (
                <section class="mt-16" aria-labelledby="actividad-mas">
                    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
                        <h2 id="actividad-mas" class="font-display text-3xl font-black leading-tight text-black sm:text-4xl">{t("news.moreActivities")}</h2>
                        <a href={novedades} class:list={["group inline-flex items-center gap-1.5 text-sm", ENLACE]}>
                            {t("news.allActivities")}
                            <Icon name="mdi:arrow-right" class="h-4 w-4 spring group-hover:translate-x-1" aria-hidden="true" />
                        </a>
                    </div>
                    <ul class="mt-8 grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-3">
                        {relacionadas.map((otra) => (
                            <li>
                                <ActividadCard actividad={otra} {locale} />
                            </li>
                        ))}
                    </ul>
                </section>
            )
        }

        {
            (anterior || siguiente) && (
                <nav class="mt-16 grid gap-4 border-t border-black/10 pt-10 sm:grid-cols-2" aria-label={t("news.backToNews")}>
                    {vecinas.map(({ vecina, etiqueta, icono, clase }) =>
                        vecina ? (
                            <a
                                href={localizePath(`/novedades/${vecina.slug}/`, locale)}
                                class:list={["group flex flex-col gap-1 rounded-2xl p-5 ring-1 ring-black/5 spring hover:-translate-y-0.5 hover:bg-white/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary", clase]}
                            >
                                <span class="inline-flex items-center gap-1.5 text-sm font-bold text-black/50">
                                    {icono === "mdi:arrow-left" && <Icon name={icono} class="h-4 w-4" aria-hidden="true" />}
                                    {etiqueta}
                                    {icono === "mdi:arrow-right" && <Icon name={icono} class="h-4 w-4" aria-hidden="true" />}
                                </span>
                                <span class="font-display text-lg font-black leading-snug text-black group-hover:text-primary">{vecina.titulo}</span>
                            </a>
                        ) : (
                            <span class="hidden sm:block" />
                        )
                    )}
                </nav>
            )
        }

        <aside class="mt-16 rounded-3xl bg-primary px-8 py-12 text-center text-white sm:px-14 sm:py-14" aria-labelledby="actividad-cta">
            <h2 id="actividad-cta" class="font-display text-3xl font-black leading-tight sm:text-4xl">{t("news.ctaTitle")}</h2>
            <p class="mx-auto mt-4 max-w-[52ch] text-lg leading-relaxed text-white/85">{t("news.ctaBody")}</p>
            <div class="mt-8 flex flex-wrap justify-center gap-4">
                <a
                    class="inline-block rounded-full bg-white px-8 py-4 font-display text-lg font-black text-primary spring press hover:scale-[1.03] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white motion-reduce:transition-none"
                    href={localizePath("/donate", locale)}
                >
                    {t("news.ctaButton")}
                </a>
                <a
                    class="inline-block rounded-full border-2 border-white/70 px-8 py-4 font-display text-lg font-black text-white spring press hover:-translate-y-0.5 hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                    href={localizePath("/about#contacto", locale)}
                >
                    {t("news.followContact")}
                </a>
            </div>
        </aside>
    </article>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</PageLayout>

<script>
    import { initReveals } from "../../scripts/reveals";
    import { initMagicButtons } from "../../scripts/magic-button";

    const initActividad = () => {
        initReveals();
        initMagicButtons();
    };

    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initActividad, { once: true });
    else initActividad();
</script>

<script>
    /* Aparte del script de arriba a propósito: ese importa GSAP (reveals,
       botón mágico) y este no debe esperarlo. Una foto o un vídeo tocados
       mientras GSAP aún llega no pueden acabar en el archivo suelto. */
    import { initGalleries } from "../../scripts/galeria";
    import { initVideoEmbeds } from "../../scripts/video-embed";

    initGalleries();
    initVideoEmbeds();
</script>
