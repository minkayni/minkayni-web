---
/* Galería de una actividad: el mosaico compartido (GalleryGrid.tsx) con su
   título y el botón de pantalla completa. Abre el visor del mapa de
   Batucada; el porqué de cargarlo bajo demanda está en scripts/galeria.ts. */
import GalleryGrid from "../react/builder/GalleryGrid";
import type { ViewerPhoto } from "../../utils/sector-photos";
import { viewerStrings } from "../../utils/viewer-strings";
import { useTranslations, type Locale } from "../../i18n";

interface Props {
    fotos: ViewerPhoto[];
    titulo: string;
    locale: Locale;
    /** Solo trae las fotos que no salieron arriba: se titula «Más fotos». */
    restantes?: boolean;
}

const { fotos, titulo, locale, restantes = false } = Astro.props;
const t = useTranslations(locale);
---

<section id="galeria" class="mt-20 scroll-mt-28" aria-labelledby="actividad-galeria">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
        <h2 id="actividad-galeria" class="font-display text-3xl font-black leading-tight text-black sm:text-4xl">
            {restantes ? t("news.morePhotos") : t("news.gallery")}
            <span class="ml-1 align-middle font-sans text-base font-bold text-black/45">{t("news.photoCount", { count: fotos.length })}</span>
        </h2>
        <button
            type="button"
            hidden
            data-gallery-open
            class="inline-flex items-center gap-2 rounded-full border-2 border-primary px-5 py-2 font-display font-bold text-primary spring press hover:-translate-y-0.5 hover:bg-primary hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
            {t("news.openGallery")}
        </button>
    </div>
    <GalleryGrid photos={fotos} caption={titulo} strings={viewerStrings(t)} openLabel={t("viewer.open")} />
</section>
