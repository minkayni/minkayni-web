---
import LOGO from "../assets/SVG/LOGO+TAG_WHITE.svg";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import PartnersLoop from "./react/PartnersLoop";
import { strapiMediaSrcSet, strapiMediaUrl } from "../utils/media-url";
import DomeSeparator from "./index/DomeSeparator.astro";
import type { NavItem, NavTree } from "../schemas/navigation";
import type { FooterContent } from "../schemas/pages.zod";
import { formatCopyright } from "../scripts/components/Copyright";
import { buildSocialItems } from "../scripts/components/socials";
import Button from "./Button.astro";
import LegalFooterBand from "./legal/LegalFooterBand.astro";
import { footerTextsFallback } from "../data/pages/global";
import { withFallback } from "../utils/content";
import { defaultLocale, localizePath, stripLocale, useTranslations, type Locale } from "../i18n";

interface Props {
    /** Árbol de navegación completo (generalmente desde Strapi) */
    primaryLinks?: NavTree;
    /** Enlaces que no vienen del árbol del CMS (Aporta hoy, Novedades,
        Transparencia): los mismos que el panel del menú lista como
        secundarios. Ver utils/menu-data.ts. */
    extraLinks?: Array<{ label: string; href: string }>;
    /** Título/nombre del grupo a extraer como navegación secundaria */
    secondaryLinks?: string;
    /** Idioma de la página que contiene el pie. */
    locale?: Locale;
    footer: FooterContent;
    /** URL a donde apunta el logo */
    logoLinkHref?: string;
    /** Fuente del logo (astro:assets) */
    logoSrc?: ImageMetadata;
}

/* El árbol llega validado como NavItem[], pero el recorrido tolera también la
   forma `name`/`href`/`children` por si el plugin de navegación de Strapi
   cambia de convención. Se declara explícitamente en vez de usar `any`. */
type LooseNavNode = NavItem & {
    name?: string;
    href?: string;
    children?: LooseNavNode[];
};

/* Busca el grupo del menú que alimenta la navegación secundaria.

   Antes se localizaba solo por título («Proyectos»), lo que dejaba de
   funcionar en cuanto el árbol venía en otro idioma. Ahora se acepta también
   la ruta —`/projects`, sin el prefijo de idioma—, que es lo único estable
   entre las dos versiones del menú. Devuelve además el título tal y como
   viene del árbol, para que el encabezado del pie salga en el idioma de la
   página y no en el del código. */
function getNavGroup(tree: NavTree | undefined, title: string | undefined, path: string): { title: string; items: NavItem[] } {
    const empty = { title: title ?? "", items: [] as NavItem[] };
    if (!tree) return empty;

    const queue: LooseNavNode[] = Array.isArray(tree) ? [...(tree as LooseNavNode[])] : [tree as LooseNavNode];
    while (queue.length) {
        const node = queue.shift();
        if (!node) continue;

        const nodeTitle = String(node.title ?? node.name ?? "");
        const nodePath = node.path ?? node.href;
        const matchesTitle = title !== undefined && nodeTitle === title;
        const matchesPath = typeof nodePath === "string" && stripLocale(nodePath) === path;

        if (matchesTitle || matchesPath) {
            const children = Array.isArray(node.items) ? node.items : Array.isArray(node.children) ? node.children : [node];
            return { title: nodeTitle || empty.title, items: children as NavItem[] };
        }

        const children = node.items ?? node.children;
        if (Array.isArray(children)) queue.push(...children);
    }
    return empty;
}

const {
    primaryLinks: navigationTree,
    secondaryLinks,
    locale = defaultLocale,
    extraLinks = [],
    footer,
    logoLinkHref = localizePath("/", locale),
    logoSrc = LOGO as unknown as ImageMetadata,
} = Astro.props;
const t = useTranslations(locale);
const donateHref = localizePath("/donate", locale);
const mainNavItems: NavItem[] = Array.isArray(navigationTree) ? navigationTree : [];
/* Los extras que el árbol del CMS ya trae no se repiten. */
const treePaths = new Set((mainNavItems as LooseNavNode[]).map((n) => stripLocale(String(n.path ?? n.href ?? "")).replace(/\/$/, "")));
const extras = extraLinks.filter((l) => !treePaths.has(stripLocale(l.href).replace(/\/$/, "")));

/* Textos editables del footer (single type `footer` en Strapi) con fallback local. */
const texts = withFallback(footerTextsFallback, {
    partnersTitle: footer?.partnersTitle,
    joinTitle: footer?.joinTitle,
    joinSubtitle: footer?.joinSubtitle,
    joinButton: footer?.joinButton,
});

const secondaryGroup = getNavGroup(navigationTree, secondaryLinks, "/projects");
const secondaryNavItems: NavItem[] = secondaryGroup.items;

/* Logos para el LogoLoop, con las mismas variantes que servía el carrusel.
   El texto alternativo sale del CMS; sin él, el logo queda como decorativo. */
const STRAPI_URL = import.meta.env.STRAPI_URL ?? "";
const partnerLogos = (footer.partnersGallery?.files ?? [])
    .filter((f): f is NonNullable<typeof f> & { url: string } => typeof f?.url === "string" && f.url.length > 0)
    .map((f) => ({
        src: strapiMediaUrl(f.url, STRAPI_URL, 440),
        srcSet: strapiMediaSrcSet(f.url, STRAPI_URL, [220, 440, 660]) || undefined,
        sizes: "220px",
        alt: f.alternativeText?.trim() ?? "",
        width: 220,
        height: 100,
    }));
---

<footer id="footer" role="contentinfo">
    <section class="relative" aria-labelledby="allies-title">
        <DomeSeparator>
            <h2 data-scroll-float id="allies-title" class="font-display font-[900] tracking-tight text-2xl md:text-6xl text-primary">{texts.partnersTitle}</h2>
        </DomeSeparator>

        <!-- Carrusel -->
        {partnerLogos.length > 0 && <PartnersLoop client:visible logos={partnerLogos} ariaLabel={t("footer.partnersCarousel")} />}
    </section>

    <section class="relative pt-10">
        <DomeSeparator isAbsolute={false} className="bg-primary" showDecoration={false}>
            <div class="text-center">
                <h2 data-scroll-float id="join-title" class="font-display font-[900] tracking-tight text-2xl md:text-6xl text-white">{texts.joinTitle}</h2>
                <p class="text-white">{texts.joinSubtitle}</p>
            </div>
        </DomeSeparator>
        <div class="w-full bg-primary py-5">
            <!-- Dos llamadas a la acción, siempre a la vista al final de cada
                 página: sumarse (contacto) y aportar (donaciones). La segunda
                 no depende del CMS: la página de aportes es del sitio. -->
            <div class="mx-auto flex w-fit max-w-[90%] flex-wrap items-center justify-center gap-4">
                <Button defaultText={texts.joinButton.defaultText} hoverText={texts.joinButton.hoverText} href={texts.joinButton.href} />
                <a
                    href={donateHref}
                    class="inline-flex min-h-12 items-center justify-center rounded-full border-2 border-white/80 px-7 py-3 font-display text-lg font-bold uppercase text-white spring press hover:-translate-y-1 hover:border-accent hover:bg-accent hover:text-black focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                >
                    {t("footer.donateCta")}
                </a>
            </div>
        </div>
    </section>
    <div class="relative w-full bg-primary text-white before:w-full before:h-1 before:bg-primary before:absolute before:-top-0.5">
        <section class="w-[90%] mx-auto relative pb-10 pt-10 grid grid-cols-1 md:grid-cols-12 gap-10 items-start" aria-labelledby="site-navigation-title">
            <h2 id="site-navigation-title" class="sr-only">{t("nav.siteNavigation")}</h2>

            <nav class="md:col-span-4" aria-label={t("nav.mainNavigation")}>
                <ul class="text-2xl sm:text-3xl md:text-4xl space-y-3">
                    {
                        mainNavItems.map((item) => {
                            const node = item as LooseNavNode;
                            const href = node.path ?? node.href;
                            const label = node.title ?? node.name ?? "";
                            return (
                                <li>
                                    <a class="hover:text-secondary transition-all duration-200 ease-in-out after:bg-secondary after:w-0 after:absolute relative after:h-[2px] after:left-0 after:bottom-0 hover:after:w-full after:transition-all after:duration-200 after:ease-in-out" href={href}>
                                        {label}
                                    </a>
                                </li>
                            );
                        })
                    }
                </ul>
                {
                    extras.length > 0 && (
                        <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-base sm:text-lg">
                            {extras.map((link) => (
                                <li>
                                    <a class="opacity-80 transition-opacity hover:opacity-100 hover:text-secondary underline-offset-4 hover:underline" href={link.href}>
                                        {link.label}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    )
                }
            </nav>

            <nav class="md:col-span-5" aria-label={t("nav.secondaryNavigation")}>
                {
                    secondaryNavItems.length > 0 && (
                        <ul class="text-base sm:text-lg md:text-xl space-y-3 md:max-w-[56ch]">
                            <li>
                                <h2 data-scroll-float class="opacity-40 font-display font-bold">{secondaryGroup.title}</h2>
                            </li>
                            {secondaryNavItems.map((item) => (
                                <li>
                                    <a class="hover:text-secondary hover:after:opacity-100 after:absolute relative after:h-2 after:w-2 after:rounded-full after:bg-secondary after:-left-4 after:top-1/2 after:-translate-y-1/2 after:opacity-0" href={item.path}>
                                        {item.title}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    )
                }
            </nav>

            <div class="md:col-span-3 text-center md:text-right md:justify-self-end">
                <div class="md:mt-12">
                    <a href={logoLinkHref} class="inline-block">
                        <Image src={logoSrc} alt={t("alt.logo")} class="w-full mx-auto md:ml-auto md:mr-0" />
                    </a>
                </div>

                <nav class="mt-8 w-full" aria-label={t("footer.socialNetworks")}>
                    <ul data-chain class="flex items-center justify-center md:justify-end gap-3 w-full">
                        {
                            footer.Socials &&
                                (() => {
                                    const items = buildSocialItems(footer.Socials);
                                    return items.map(({ href, icon, label }) => (
                                        <li>
                                            <a href={href} aria-label={label} title={label} class="inline-flex items-center justify-center bg-secondary rounded-full p-3 text-white hover:bg-accent shadow-md hover:shadow-lg spring press focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2" target="_blank" rel="noopener noreferrer">
                                                <Icon name={icon} class="w-5 h-5 md:w-6 md:h-6" aria-hidden="true" />
                                            </a>
                                        </li>
                                    ));
                                })()
                        }
                    </ul>
                </nav>
            </div>
        </section>

        <!-- Línea legal (visible en todo el sitio) -->
        <LegalFooterBand />
    </div>

    <!-- Créditos sobre el celeste de marca: tinta negra, no blanca. El blanco
         al 80 % daba 2,5:1 de contraste (Lighthouse lo marcaba en todas las
         páginas); el negro es la tinta que el sitio ya usa sobre ese azul. -->
    <section class="bg-secondary py-5 md:px-10 flex flex-col md:flex-row items-center justify-center md:justify-between gap-3 text-sm md:text-base" aria-label={t("nav.legalCredits")}>
        <div class="w-full">
            <div class="flex flex-wrap justify-center md:justify-start gap-x-5 gap-y-1">
                <p>
                    {
                        footer.Copyright && (
                            <>
                                <span class="text-black opacity-80">
                                    {formatCopyright({
                                        legalName: footer.Copyright.legalname,
                                        yearStart: footer.Copyright.yearStart,
                                        autoYear: footer.Copyright.autoYear,
                                        yearOverride: footer.Copyright.yearOverride,
                                    })}
                                </span>
                                {footer.Copyright.extraText && <span> · {footer.Copyright.extraText}</span>}
                            </>
                        )
                    }
                </p>
                {
                    footer.privacyLink && (
                        <a href={footer.privacyLink?.href} class="text-black opacity-80 hover:opacity-100 hover:text-primary">
                            {" "}
                            {footer.privacyLink?.text}
                        </a>
                    )
                }
                {
                    footer.termsLink && (
                        <a href={footer.termsLink?.href} class="text-black hover:text-primary opacity-80 hover:opacity-100">
                            {footer.termsLink?.text}
                        </a>
                    )
                }
                {/* Volver a abrir el aviso de cookies. Lo escucha
                    CookieConsent.astro por `data-cookie-prefs`; sin JavaScript
                    tampoco hay medición que revisar, así que se oculta. */}
                <button type="button" class="hidden text-black opacity-80 hover:text-primary hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary [html[data-js]_&]:inline" data-cookie-prefs>
                    {t("cookies.settings")}
                </button>
            </div>
        </div>
        <div class="w-full text-center">
            <span class="text-black opacity-80">{t("footer.developedBy")} </span>
            <a href="https://allmylinks.com/definitelynotisai" class="text-black opacity-80 hover:opacity-100 after:absolute relative after:h-[1px] hover:after:bg-primary after:w-full hover:after:w-0 hover:text-primary after:bg-black after:left-0 after:bottom-0 after:transition-all after:duration-200 after:ease-in-out" rel="noopener noreferrer" target="_blank">Isaí Tobar</a>
        </div>
        <div class="w-full text-center md:text-right">
            <span class="text-black opacity-80">{t("footer.madeWith")}</span>
            <a class="text-black hover:text-primary opacity-80 hover:opacity-100" href="https://astro.build" rel="noopener noreferrer" target="_blank"><Icon name="simple-icons:astro" class="inline-block" />{Astro.generator}</a>
        </div>
    </section>
</footer>

<script>
    /* Redes en cadena: el icono tocado salta y los vecinos lo siguen. */
    import { initCartoon } from "../scripts/cartoon";

    initCartoon(document.querySelector("footer") ?? document);
</script>
