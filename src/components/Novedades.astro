---
/* Lista de novedades, compartida por /novedades y /en/news.
 *
 * Es HTML plano a propósito: sin islas, sin animación al hacer scroll y sin
 * más JavaScript que el del sitio. La página existe para que se lea —una
 * persona y un rastreador— y para que el sitio deje de parecer congelado
 * desde 2020. Cada entrada lleva su `<time datetime>`, su texto completo y el
 * enlace al original.
 *
 * Los datos salen de src/utils/novedades.ts; ahí está el porqué del troceo del
 * pie de foto en titular y cuerpo.
 *
 * Arriba de las publicaciones van las actividades de campo (Actividades.astro),
 * cada una con su propia página en /novedades/<slug>.
 */
import { Icon } from "astro-icon/components";

import Actividades from "./novedades/Actividades.astro";
import { NOVEDADES_POR_PAGINA, paginaDe, totalPaginas, type Novedad } from "../utils/novedades";
import type { ActividadResumen } from "../utils/actividades-core";
import { localizePath, useTranslations, type Locale } from "../i18n";
import { buildSocialItems } from "../scripts/components/socials";
import { fallbackFooter } from "../data/site";
import { globalFallback } from "../data/pages/global";
import type { Footer } from "../schemas/strapi.graphql.zod";

interface Props {
    /** Todas las novedades; el componente pinta solo las de `pagina`. */
    novedades: Novedad[];
    /** Página del listado, desde 1. Las actividades solo van en la primera. */
    pagina?: number;
    /** Actividades de campo del CMS, ya ordenadas. Se pintan en la primera
        página; en todas sirven para enlazar cada publicación con su actividad. */
    actividades?: ActividadResumen[];
    locale: Locale;
    /** Redes del single type `footer`; sin CMS se usan las del respaldo. */
    socials?: Footer["Socials"] | null;
    /** Correo de contacto del single type `global`. */
    contactEmail?: string | null;
}

const { novedades, pagina = 1, locale, socials = fallbackFooter.Socials, contactEmail = globalFallback.contactEmail } = Astro.props;
const actividades = pagina === 1 ? (Astro.props.actividades ?? []) : [];
/* Publicación de redes → la actividad que la cuenta entera (por `documentId`
   o por URL, ver `publicaciones` en actividades-core.ts). */
const actividadDe = new Map((Astro.props.actividades ?? []).flatMap((a) => a.publicaciones.map((p) => [p, a.slug] as const)));
const enlaceActividad = (novedad: Novedad) => {
    const slug = actividadDe.get(novedad.id) ?? actividadDe.get(novedad.permalink);
    return slug ? localizePath(`/novedades/${slug}/`, locale) : undefined;
};
const t = useTranslations(locale);
const paginas = totalPaginas(novedades);
const visibles = paginaDe(novedades, pagina);
const urlDePagina = (n: number) => localizePath(n === 1 ? "/novedades" : `/novedades/pagina/${n}`, locale);
const desplazamiento = (pagina - 1) * NOVEDADES_POR_PAGINA;
const socialItems = buildSocialItems(socials ?? fallbackFooter.Socials);
const contacto = localizePath("/about#contacto", locale);
const proyectos = localizePath("/projects", locale);
const impacto = localizePath("/impact", locale);
/* Titular y párrafos son el texto original de la publicación, en español
   (ver Moments.astro: la sincronización lo reescribe, no se traduce). */
const postLang = locale === "es" ? undefined : "es";
const donar = localizePath("/donate", locale);
const SALTO =
    "group inline-flex items-center gap-2 rounded-full border-2 border-primary/30 px-4 py-2 font-display font-bold text-primary spring press hover:-translate-y-0.5 hover:border-primary hover:bg-primary hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
/* Con más de dos párrafos se ven los dos primeros y el resto se despliega:
   el texto entero sigue en el HTML, pero doce publicaciones completas
   seguidas hacían de la página un muro. */
const PARRAFOS_VISIBLES = 2;

/* Un listado fechado es la señal de frescura que un buscador entiende sin
   adivinar. `SocialMediaPosting` es el tipo exacto: son publicaciones de las
   redes de la fundación reproducidas aquí con su texto completo, no artículos
   escritos para la web. */
const jsonLd = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: t("news.title"),
    description: t("news.metaDescription"),
    inLanguage: locale === "es" ? "es-EC" : "en",
    url: Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined,
    mainEntity: {
        "@type": "ItemList",
        numberOfItems: novedades.length,
        itemListElement: visibles.map((novedad, indice) => ({
            "@type": "ListItem",
            position: desplazamiento + indice + 1,
            item: {
                "@type": "SocialMediaPosting",
                headline: novedad.titular,
                datePublished: novedad.fechaIso,
                url: novedad.permalink,
                author: { "@type": "Organization", name: "Fundación Minkayni" },
            },
        })),
    },
};
---

{/* `data-cms-empty` marca una build sin publicaciones del CMS (local sin
    Strapi). La auditoría de Ad Grants (tests/ad-grants.test.ts) lo lee para
    no juzgar la cantidad de contenido de una página cuyo cuerpo no llegó. */}
<div class="mx-auto w-[90%] max-w-[1100px] pb-[calc(4rem+150px)] pt-16 sm:pt-24 md:pb-[calc(6rem+300px)]" data-cms-empty={novedades.length === 0 && actividades.length === 0 ? "" : undefined}>
    <header class="max-w-[70ch]">
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-primary">{t("news.eyebrow")}</p>
        <p class="text-lg leading-relaxed text-black/75">{t("news.lead")}</p>

        {
            novedades.length > 0 && (
                <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-black/60">
                    <span>
                        {t("news.updated")}{" "}
                        <time datetime={novedades[0].fechaIso} class="font-bold text-black/80">
                            {novedades[0].fechaTexto}
                        </time>
                    </span>
                    <span aria-hidden="true">·</span>
                    <span>{t("news.count", { count: novedades.length })}</span>
                    {paginas > 1 && (
                        <>
                            <span aria-hidden="true">·</span>
                            <span>{t("news.pageOf", { page: pagina, total: paginas })}</span>
                        </>
                    )}
                </p>
            )
        }

        {
            actividades.length > 0 && novedades.length > 0 && (
                <nav class="mt-8" aria-label={t("news.jumpTo")}>
                    <ul class="flex list-none flex-wrap gap-3 p-0">
                        <li>
                            <a href="#actividades" class={SALTO}>
                                <Icon name="mdi:map-marker-radius-outline" class="h-5 w-5" aria-hidden="true" />
                                {t("news.activitiesTitle")}
                                <span class="rounded-full bg-primary/10 px-2 text-sm group-hover:bg-white/20">{actividades.length}</span>
                            </a>
                        </li>
                        <li>
                            <a href="#novedades-redes" class={SALTO}>
                                <Icon name="mdi:instagram" class="h-5 w-5" aria-hidden="true" />
                                {t("news.fromSocials")}
                                <span class="rounded-full bg-primary/10 px-2 text-sm group-hover:bg-white/20">{novedades.length}</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            )
        }
    </header>

    <Actividades {actividades} {locale} />

    {
        actividades.length > 0 && novedades.length > 0 && (
            <h2 id="novedades-redes" class="mt-20 scroll-mt-28 font-display text-3xl font-black leading-tight text-black sm:mt-28 sm:text-4xl">
                {t("news.fromSocials")}
            </h2>
        )
    }

    {
        novedades.length === 0 ? (
            actividades.length === 0 && <p class="mt-16 text-lg text-black/60">{t("empty.posts")}</p>
        ) : (
            <ol class="mt-14 list-none space-y-14 border-t border-black/10 p-0 sm:mt-20 sm:space-y-20">
                {visibles.map((novedad) => (
                    <li>
                        <article class="grid gap-6 pt-14 sm:pt-20 md:grid-cols-[minmax(0,18rem)_1fr] md:gap-10">
                            {/* La foto va con `alt` vacío a propósito: el titular
                                y el cuerpo que vienen al lado ya cuentan lo que
                                pasó, y describirla otra vez solo hace que un
                                lector de pantalla lo oiga dos veces. */}
                            {novedad.imagen ? (
                                <a
                                    href={novedad.permalink}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    tabindex="-1"
                                    aria-hidden="true"
                                    class="group relative block self-start overflow-hidden rounded-2xl bg-black/5 shadow-sm md:sticky md:top-28"
                                >
                                    <img
                                        class="w-full object-cover spring group-hover:scale-[1.03] motion-reduce:group-hover:scale-100"
                                        src={novedad.imagen.src}
                                        srcset={novedad.imagen.srcset || undefined}
                                        sizes="(min-width: 768px) 18rem, 90vw"
                                        width={novedad.imagen.ancho}
                                        height={novedad.imagen.alto}
                                        alt=""
                                        loading="lazy"
                                        decoding="async"
                                    />
                                    {novedad.tipo === "reel" && (
                                        <span class="absolute left-3 top-3 inline-flex items-center gap-1 rounded-full bg-black/60 px-3 py-1 text-xs font-bold text-white backdrop-blur-sm">
                                            <Icon name="mdi:play" class="h-4 w-4" />
                                            {t("news.reel")}
                                        </span>
                                    )}
                                </a>
                            ) : (
                                <div class="hidden md:block" aria-hidden="true" />
                            )}

                            <div class="max-w-[68ch]">
                                <time
                                    datetime={novedad.fechaIso}
                                    class="text-sm font-bold uppercase tracking-[0.18em] text-primary"
                                >
                                    {novedad.fechaTexto}
                                </time>

                                <h2 class="mt-3 font-display text-2xl font-black leading-tight text-black sm:text-3xl" lang={postLang}>
                                    {novedad.titular}
                                </h2>

                                {novedad.parrafos.length > 0 && (
                                    <div class="mt-5 space-y-4 text-base leading-relaxed text-black/75" lang={postLang}>
                                        {novedad.parrafos.slice(0, PARRAFOS_VISIBLES).map((parrafo) => (
                                            <p>{parrafo}</p>
                                        ))}
                                        {novedad.parrafos.length > PARRAFOS_VISIBLES && (
                                            <details class="group">
                                                <summary class="inline-flex cursor-pointer list-none items-center [&::-webkit-details-marker]:hidden gap-1 font-bold text-primary underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" lang={locale}>
                                                    {t("news.readMore")}
                                                    <Icon name="mdi:chevron-down" class="h-5 w-5 spring group-open:rotate-180" aria-hidden="true" />
                                                </summary>
                                                <div class="mt-4 space-y-4">
                                                    {novedad.parrafos.slice(PARRAFOS_VISIBLES).map((parrafo) => (
                                                        <p>{parrafo}</p>
                                                    ))}
                                                </div>
                                            </details>
                                        )}
                                    </div>
                                )}

                                {novedad.etiquetas.length > 0 && (
                                    <ul
                                        class="mt-6 flex list-none flex-wrap gap-2 p-0"
                                        aria-label={t("news.tags")}
                                    >
                                        {novedad.etiquetas.map((etiqueta) => (
                                            <li class="rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary">
                                                #{etiqueta}
                                            </li>
                                        ))}
                                    </ul>
                                )}

                                <p class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
                                    {enlaceActividad(novedad) && (
                                        <a
                                            class="group inline-flex items-center gap-1.5 rounded-full bg-primary px-4 py-2 font-bold text-white spring press hover:-translate-y-0.5 hover:bg-secondary-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                                            href={enlaceActividad(novedad)}
                                        >
                                            {t("news.readActivity")}
                                            <Icon name="mdi:arrow-right" class="h-4 w-4 spring group-hover:translate-x-1" aria-hidden="true" />
                                        </a>
                                    )}
                                    <a
                                        class="inline-flex items-center gap-1.5 font-bold text-primary underline underline-offset-4 transition hover:text-secondary-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                                        href={novedad.permalink}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        {novedad.tipo === "reel" ? t("news.viewOriginalReel") : t("news.viewOriginal")}
                                        <Icon name="mdi:open-in-new" class="h-4 w-4" aria-hidden="true" />
                                    </a>
                                    {novedad.meGusta !== undefined && (
                                        <span class="text-black/50">{t("news.likes", { count: novedad.meGusta })}</span>
                                    )}
                                </p>
                            </div>
                        </article>
                    </li>
                ))}
            </ol>
        )
    }

    {
        paginas > 1 && (
            <nav class="mt-16 flex flex-wrap items-center justify-center gap-3 sm:mt-20" aria-label={t("news.pagination")}>
                {pagina > 1 && (
                    <a href={urlDePagina(pagina - 1)} rel="prev" class="rounded-full border-2 border-primary px-5 py-2 font-display font-bold text-primary transition hover:bg-primary hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                        ← {t("news.newer")}
                    </a>
                )}
                <ol class="flex list-none flex-wrap items-center gap-2 p-0">
                    {Array.from({ length: paginas }, (_, i) => i + 1).map((n) => (
                        <li>
                            {n === pagina ? (
                                <span aria-current="page" class="inline-flex h-11 min-w-11 items-center justify-center rounded-full bg-primary px-3 font-display font-bold text-white">
                                    {n}
                                </span>
                            ) : (
                                <a href={urlDePagina(n)} aria-label={t("news.pageOf", { page: n, total: paginas })} class="inline-flex h-11 min-w-11 items-center justify-center rounded-full px-3 font-display font-bold text-primary transition hover:bg-primary/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                                    {n}
                                </a>
                            )}
                        </li>
                    ))}
                </ol>
                {pagina < paginas && (
                    <a href={urlDePagina(pagina + 1)} rel="next" class="rounded-full border-2 border-primary px-5 py-2 font-display font-bold text-primary transition hover:bg-primary hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                        {t("news.older")} →
                    </a>
                )}
            </nav>
        )
    }

    <!-- Cómo seguir la actividad y cómo participar. Es texto fijo del sitio:
         no depende de que el CMS haya devuelto publicaciones, así que la
         página nunca se queda en un titular y un botón. -->
    <section class="mt-20 grid gap-8 rounded-3xl border border-black/10 bg-white/50 px-8 py-10 sm:mt-28 sm:px-12 md:grid-cols-[1.2fr_1fr] md:gap-12" aria-labelledby="novedades-follow">
        <div class="max-w-[60ch]">
            <h2 id="novedades-follow" class="font-display text-3xl font-black leading-tight text-black sm:text-4xl">{t("news.followTitle")}</h2>
            <p class="mt-4 text-lg leading-relaxed text-black/75">{t("news.followBody")}</p>
            <ul class="mt-6 list-none space-y-2 p-0 text-base">
                <li>
                    <a href={contacto} class="font-bold text-primary underline underline-offset-4 hover:text-secondary-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{t("news.followContact")}</a>
                    {contactEmail && (
                        <span class="text-black/60">
                            {" "}· <a href={`mailto:${contactEmail}`} class="underline underline-offset-4 hover:text-primary">{contactEmail}</a>
                        </span>
                    )}
                </li>
                <li><a href={proyectos} class="font-bold text-primary underline underline-offset-4 hover:text-secondary-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{t("news.followProjects")}</a></li>
                <li><a href={impacto} class="font-bold text-primary underline underline-offset-4 hover:text-secondary-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{t("news.followImpact")}</a></li>
            </ul>
        </div>
        <nav aria-label={t("news.followSocials")}>
            <p class="text-sm font-bold uppercase tracking-[0.22em] text-primary">{t("news.followSocials")}</p>
            <ul class="mt-4 list-none space-y-3 p-0">
                {socialItems.map(({ href, icon, label }) => (
                    <li>
                        <a href={href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 font-display text-lg font-bold text-black transition hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-secondary text-white" aria-hidden="true">
                                <Icon name={icon} class="h-5 w-5" />
                            </span>
                            {label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </section>

    <aside
        class="mt-16 rounded-3xl bg-primary px-8 py-12 text-center text-white sm:mt-20 sm:px-14 sm:py-16"
        aria-labelledby="novedades-cta"
    >
        <h2 id="novedades-cta" class="font-display text-3xl font-black leading-tight sm:text-4xl">
            {t("news.ctaTitle")}
        </h2>
        <p class="mx-auto mt-4 max-w-[52ch] text-lg leading-relaxed text-white/85">{t("news.ctaBody")}</p>
        <a
            class="mt-8 inline-block rounded-full bg-white px-8 py-4 font-display text-lg font-black text-primary spring press hover:scale-[1.03] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
            href={donar}
        >
            {t("news.ctaButton")}
        </a>
    </aside>
</div>

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
