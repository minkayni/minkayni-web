---
import Reloj from "./Reloj.astro";

import Button from "./Button.astro";

import IsotipoIcon from "../assets/SVG/ISOTIPO_WHITE.svg";
import LogoIconWhite from "../assets/SVG/LOGO_WHITE.svg";
import NavMenu from "./react/NavMenu";
import LangMenu from "./react/LangMenu";
import BurgerIcon from "./BurgerIcon.astro";
import type { MenuData } from "./react/menu-types";
import type { NavTree } from "../schemas/navigation";
import { defaultLocale, localizePath, useTranslations, type Locale } from "../i18n";

interface Props {
    buttons: NavTree;
    /** Datos del megamenú y del panel (ver utils/menu-data.ts). */
    menu: MenuData;
    /** Idioma de la página. Define el texto accesible y el estado del selector. */
    locale?: Locale;
    /** Clase extra para el botón CTA (no lo toca la tinta adaptativa). */
    buttonClassName?: string;
    /** Desactiva la tinta adaptativa y deja el navbar siempre en crema. */
    enableTheming?: boolean;
    /** La página trae la intro de la portada: el navbar espera tapado y entra en cascada al terminar. */
    intro?: boolean;
}

const { buttons, menu, buttonClassName = "", enableTheming = true, locale = defaultLocale, intro = false } = Astro.props;
/* Enlaces de la barra: los de estilo normal, en su orden. El CTA se pinta aparte. */
const barItems = menu.items.filter((item) => buttons.some((b) => b.path === item.href && (b.additionalFields?.style ?? "default") === "default"));
const t = useTranslations(locale);
const homeHref = localizePath("/", locale);
---

<div class="fixed w-full h-[90px] z-50" id="nav-container" data-nav-theming={enableTheming}>
    <div class="nav-fade" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
    <div class="mx-10 h-full overflow-hidden">
        <div class="h-full w-full">
            <div id="nav-switcher" class="max-lg:-translate-y-[100px]">
                <div id="navBase" class="flex items-center h-[90px] justify-between text-lg text-white font-medium">
                    <a href={homeHref} class="animate" aria-label={t("nav.goHome")}>
                        <IsotipoIcon class="h-10 mr-10" />
                    </a>
                    {/* Megamenú de escritorio (Aceternity navbar-menu): enlaces,
                        desplegable de proyectos y selector de idioma. Hidratan con
                        el LCP ya anotado (`client:lcp`, ver src/directives/lcp.ts):
                        salen ya visibles del servidor y lo único que aporta la
                        hidratación es el desplegable al pasar el cursor. En
                        `client:load` su React más motion (120 KB) corría en la
                        misma tanda que el resto y PageSpeed lo cargaba al TBT; en
                        idle se pedía antes del LCP y lo sumaba al LCP. */}
                    <NavMenu client:lcp items={barItems} projectsHref={menu.projectsHref} projects={menu.projects} languages={menu.languages} labels={menu.labels} intro={intro} />
                    <Reloj locale={locale} />
                    <div class="nav-cta flex items-center">
                        {
                            buttons.map((button) => {
                                if (button.additionalFields?.style === "cta" && button.path) {
                                    return <Button href={button.path} defaultText={button.title} hoverText={String(button.additionalFields?.ctaText)} className={buttonClassName} />;
                                }
                                return null;
                            })
                        }
                    </div>
                </div>
                <div id="navScrolled" class="flex items-center h-[90px] justify-between">
                    <a href={homeHref} aria-label={t("nav.goHome")}>
                        <LogoIconWhite class="h-10 w-auto" />
                    </a>
                    {/* Idioma (mismo desplegable que en la barra completa) y la
                        hamburguesa animada de siempre. El panel vive fuera del
                        navbar y se hablan por eventos: el botón dispara
                        `site-menu:toggle` y el panel confirma con `menu:state`,
                        que BurgerIcon ya escuchaba para girar su icono. */}
                    <div class="flex items-center gap-4 sm:gap-6">
                        <LangMenu client:lcp languages={menu.languages} labels={menu.labels} />
                        {/* La hamburguesa se dibuja a la mitad de su tamaño
                            (`scale-50 origin-right`) sobre una caja de 100px y
                            arrastra 50px de espacio muerto a su izquierda; el
                            margen negativo lo recupera sin tocar el icono. */}
                        <div class="-ml-[50px] flex items-center">
                            <button
                                type="button"
                                id="site-menu-button"
                                class="cursor-pointer border-0 bg-transparent p-0 text-current focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current"
                                aria-label={menu.labels.open}
                                aria-expanded="false"
                                aria-controls="site-menu-panel"
                                data-open-label={menu.labels.open}
                                data-close-label={menu.labels.close}
                            >
                                <BurgerIcon />
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style is:global>
    /* ── Visible desde el primer cuadro ───────────────────────────────────
       El navbar viene en el HTML y se pinta con la página. Antes se ocultaba
       bajo `html[data-js]` hasta que el script lo mostraba y lo hacía entrar
       en cascada; con los scripts detrás del contenido, en móvil eso era una
       barra invisible durante dos segundos (PageSpeed lo cargaba al Speed
       Index). La cascada queda para cuando de verdad hay algo que revelar:
       la intro de la portada, que tapa la página entera. `data-intro` lo
       escribe head.astro antes del primer pintado, solo cuando la intro va a
       reproducirse, e intro.ts lo retira al acabar. */
    html[data-intro="pending"] #nav-container {
        display: none;
    }
    /* El megamenú (NavMenu.tsx) se sirve con sus ítems en el estado inicial
       de la cascada —transparentes, desenfocados y sin puntero— y es la
       hidratación quien los revela. Sin JavaScript no hay hidratación, así
       que aquí se anula ese estado y los enlaces quedan a la vista y
       pulsables. */
    html:not([data-js]) #navBase nav[aria-label] {
        pointer-events: auto !important;
    }
    html:not([data-js]) #navBase nav[aria-label] > [style] {
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
    }

    /* ── Tinta adaptativa del navbar ──────────────────────────────────────
       `data-nav-theme` lo escribe el script según el fondo que haya debajo:
         dark  → fondo oscuro  → tinta crema
         light → fondo claro   → tinta negra
       Todo el contenido usa `currentColor` (los SVG del logo, el isotipo y
       la hamburguesa ya vienen con `stroke="currentColor"`), así que basta
       con animar `color`. El CTA queda excluido con `.nav-cta`. */
    #nav-container {
        --nav-ink: var(--bg-white);
        /* Color del texto que va SOBRE la tinta (la píldora activa del
           selector de idioma): el inverso de --nav-ink en cada tema. */
        --nav-ink-contrast: var(--text);
    }

    #nav-container[data-nav-theme="light"] {
        --nav-ink: var(--text);
        --nav-ink-contrast: var(--bg-white);
    }

    #nav-container :is(#navBase, #navScrolled),
    #nav-container :is(#navBase, #navScrolled) :is(a, p, span, div, svg, button, nav):not(.nav-cta):not(.nav-cta *) {
        color: var(--nav-ink);
        transition: color 350ms ease;
    }

    #nav-container :is(#navBase, #navScrolled) .underline:not(.nav-cta *) {
        background-color: var(--nav-ink);
        transition: background-color 350ms ease, transform 300ms ease;
    }

    /* ── Desvanecimiento al desplazarse ────────────────────────────────────
       El navbar no tiene fondo: sobre texto, el logo y la hamburguesa se
       mezclaban con las líneas que pasaban por debajo. Con la página ya
       desplazada, lo que sube hacia el borde se va desenfocando y
       aclarando poco a poco, sin barra ni corte, como en iOS:

       1. Desenfoque progresivo: cinco capas de `backdrop-filter` que doblan
          su radio (0,5 → 8 px), cada una enmascarada a su franja. Una sola
          capa con máscara deja ver dónde empieza el desenfoque; escalonadas,
          el paso de nítido a borroso se reparte por toda la altura.
       2. Velo crema (solo con tinta negra, sobre contenido claro) con
          curva suavizada en lugar de lineal: un degradado lineal hace
          visible la línea donde termina; con la curva (la de los «scrim»
          de Material/Andreas Larsen) su final no se nota.

       Va por debajo del contenido del navbar (z-index -1) y llega 40 px
       más abajo que la barra para que el final quede bien difuminado.
       `data-scrolled` y `data-menu-open` los escribe el script de abajo. */
    .nav-fade {
        position: absolute;
        inset: 0 0 -40px;
        z-index: -1;
        pointer-events: none;
        opacity: 0;
        visibility: hidden;
        transition: opacity 300ms ease, visibility 0s linear 300ms;
    }

    #nav-container[data-scrolled]:not([data-menu-open]) .nav-fade {
        opacity: 1;
        visibility: visible;
        transition: opacity 300ms ease;
    }

    .nav-fade > i,
    .nav-fade::before {
        position: absolute;
        inset: 0;
    }

    .nav-fade > i {
        --mask: linear-gradient(to top, transparent var(--a), #000 var(--b), #000 var(--c), transparent var(--d));
        -webkit-backdrop-filter: blur(var(--blur));
        backdrop-filter: blur(var(--blur));
        -webkit-mask-image: var(--mask);
        mask-image: var(--mask);
    }

    .nav-fade > i:nth-child(1) { --blur: 0.5px; --a: 0%; --b: 12.5%; --c: 25%; --d: 37.5%; }
    .nav-fade > i:nth-child(2) { --blur: 1px; --a: 12.5%; --b: 25%; --c: 37.5%; --d: 50%; }
    .nav-fade > i:nth-child(3) { --blur: 2px; --a: 25%; --b: 37.5%; --c: 50%; --d: 62.5%; }
    .nav-fade > i:nth-child(4) { --blur: 4px; --a: 37.5%; --b: 50%; --c: 62.5%; --d: 75%; }
    .nav-fade > i:nth-child(5) { --blur: 8px; --a: 50%; --b: 62.5%; --c: 100%; --d: 100%; }

    .nav-fade::before {
        content: "";
        --veil: var(--bg-white);
        background: linear-gradient(
            to bottom,
            color-mix(in srgb, var(--veil) 92%, transparent) 0%,
            color-mix(in srgb, var(--veil) 68%, transparent) 19%,
            color-mix(in srgb, var(--veil) 50%, transparent) 34%,
            color-mix(in srgb, var(--veil) 35%, transparent) 47%,
            color-mix(in srgb, var(--veil) 26%, transparent) 56.5%,
            color-mix(in srgb, var(--veil) 17%, transparent) 65%,
            color-mix(in srgb, var(--veil) 11%, transparent) 73%,
            color-mix(in srgb, var(--veil) 6%, transparent) 80.2%,
            color-mix(in srgb, var(--veil) 3.5%, transparent) 86.1%,
            color-mix(in srgb, var(--veil) 1.8%, transparent) 91%,
            color-mix(in srgb, var(--veil) 0.7%, transparent) 95.2%,
            transparent 100%
        );
        opacity: 0;
        transition: opacity 300ms ease;
    }

    /* Sobre fondos oscuros la tinta crema ya contrasta: solo desenfoque. */
    #nav-container[data-nav-theme="light"] .nav-fade::before {
        opacity: 1;
    }

    /* Quien pide menos transparencias recibe un velo opaco y sin desenfoque. */
    @media (prefers-reduced-transparency: reduce) {
        .nav-fade > i {
            display: none;
        }
        .nav-fade::before {
            background: linear-gradient(to bottom, var(--bg-white) 70%, transparent 100%);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #nav-container :is(#navBase, #navScrolled),
        #nav-container :is(#navBase, #navScrolled) * {
            transition: none;
        }
    }
</style>

<script>
    import { gsap, ScrollTrigger } from "../scripts/main.ts";

    const initNavSwitcher = () => {
        const navSwitcher = document.getElementById("nav-switcher");
        if (!navSwitcher) return;

        // Instancia matchMedia (reemplaza al deprecado ScrollTrigger.matchMedia)
        const mm = gsap.matchMedia();

        mm.add("(min-width: 1024px)", () => {
            const header = document.getElementById("header");
            const smoothContent = document.getElementById("smooth-content");
            const triggerEl = header || smoothContent || document.body;

            gsap.to(navSwitcher, {
                y: -100,
                ease: "none",
                scrollTrigger: {
                    trigger: triggerEl,
                    start: "top top",
                    end: "+=300",
                    scrub: true,
                    invalidateOnRefresh: true,
                },
            });

            requestAnimationFrame(() => ScrollTrigger.refresh());
        });

        /* ──────────────────────────────────────────────────────────────
           Tinta adaptativa del navbar.

           Sustituye al viejo `mix-blend-difference` sobre todo el navbar.
           Aquel invertía TODO lo que hubiera dentro —incluido el botón de
           donación, que salía naranja— y como `position: fixed` crea un
           contexto de apilamiento, no había forma de excluir un hijo del
           filtro sin sacarlo del contenedor.

           En su lugar, el navbar mira qué hay justo debajo y adopta la
           tinta que corresponde (crema sobre fondos oscuros, tinta negra
           sobre claros) con una transición de color. El botón CTA conserva
           sus colores de marca porque ya no hay filtro que lo toque.

           Cómo decide, en orden:
           1. `data-nav-theme` explícito en el elemento o un ancestro;
           2. el color de fondo del primer elemento que pinte algo;
           3. si solo hay imagen/degradado de fondo, el color de texto de
              ese elemento (texto claro ⇒ fondo oscuro).
        ────────────────────────────────────────────────────────────────── */
        const container = document.getElementById("nav-container");
        if (!container) return;

        const themingAttr = container.dataset.navTheming;
        const themingEnabled = themingAttr === undefined ? true : themingAttr === "true" || themingAttr === "1";
        if (!themingEnabled) return;

        /* Normaliza cualquier color CSS (incluidos oklab/color-mix) a rgba */
        const probe = document.createElement("canvas").getContext("2d");
        const toRgba = (value: string): [number, number, number, number] => {
            if (!probe || !value || value === "transparent") return [0, 0, 0, 0];
            probe.fillStyle = "#000";
            probe.fillStyle = value;
            const out = probe.fillStyle as string;
            if (out.startsWith("#")) {
                const n = parseInt(out.slice(1), 16);
                return [(n >> 16) & 255, (n >> 8) & 255, n & 255, 1];
            }
            const parts = out.match(/[\d.]+/g)?.map(Number) ?? [0, 0, 0, 0];
            return [parts[0] ?? 0, parts[1] ?? 0, parts[2] ?? 0, parts[3] ?? 1];
        };

        const luminance = ([r, g, b]: number[]) => {
            const f = (v: number) => {
                v /= 255;
                return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
            };
            return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b);
        };

        const contrast = (a: number, b: number) => (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);

        /* Las dos tintas posibles del navbar, resueltas una vez desde el tema. */
        const rootStyle = getComputedStyle(document.documentElement);
        const creamLum = luminance(toRgba(rootStyle.getPropertyValue("--bg-white").trim() || "#FFF6E5"));
        const inkLum = luminance(toRgba(rootStyle.getPropertyValue("--text").trim() || "#0A0801"));

        /* Elige la tinta que MÁS contraste da sobre ese fondo, en vez de un
           umbral de luminancia: así los tonos medios de marca (el azul
           #29aae1 de Batucada, el celeste del pie) reciben tinta negra, que
           es la que usan esas secciones para su propio texto. */
        const bestInkFor = (bg: number[]): "dark" | "light" => {
            const bgLum = luminance(bg);
            return contrast(creamLum, bgLum) >= contrast(inkLum, bgLum) ? "dark" : "light";
        };

        /** Tema del fondo en un punto de la pantalla. */
        const themeAt = (x: number, y: number): "dark" | "light" | null => {
            const stack = document.elementsFromPoint(x, y) as HTMLElement[];
            for (const el of stack) {
                /* No cuentan ni el propio navbar ni lo que tapa la página
                   entera de forma pasajera: la cortina de píxeles, que al navegar cubre todo con el
                   morado de marca y haría leer un fondo que no es el de
                   esta página. */
                if (container.contains(el) || el.closest("#nav-container, [data-pixel-curtain]")) continue;

                const marked = el.closest<HTMLElement>("[data-nav-theme]");
                if (marked) return marked.dataset.navTheme === "dark" ? "dark" : "light";

                const cs = getComputedStyle(el);
                const bg = toRgba(cs.backgroundColor);
                if (bg[3] >= 0.5) return bestInkFor(bg);
                if (cs.backgroundImage && cs.backgroundImage !== "none") {
                    /* solo degradado/imagen: nos guiamos por su color de texto */
                    return luminance(toRgba(cs.color)) > 0.5 ? "dark" : "light";
                }
            }
            return null;
        };

        /* Se muestrea donde de verdad hay contenido —logo, centro y botón/
           hamburguesa— y gana la mayoría. Los puntos extremos importan:
           las secciones "isla" (tarjetas moradas al 94% de ancho) dejan
           crema en los márgenes, que es justo donde queda el logo cuando el
           navbar ya está en su estado compacto. */
        const resolveTheme = (): "dark" | "light" => {
            const y = Math.round((container.offsetHeight || 90) / 2);
            const w = window.innerWidth;
            let dark = 0;
            let light = 0;
            for (const x of [60, Math.round(w / 2), w - 60]) {
                const theme = themeAt(x, y);
                if (theme === "dark") dark += 1;
                else if (theme === "light") light += 1;
            }
            return dark > light ? "dark" : "light";
        };

        let lastRun = 0;
        let pending = 0;
        const applyTheme = () => {
            lastRun = performance.now();
            const theme = resolveTheme();
            if (container.dataset.navTheme !== theme) container.dataset.navTheme = theme;
            container.toggleAttribute("data-scrolled", window.scrollY > 24);
        };

        /* El muestreo fuerza recálculo de estilos: se limita a ~12 veces por
           segundo, imperceptible frente a la transición de 350 ms. */
        const scheduleTheme = () => {
            const now = performance.now();
            if (now - lastRun >= 80) {
                applyTheme();
                return;
            }
            if (pending) return;
            pending = window.setTimeout(() => {
                pending = 0;
                applyTheme();
            }, 80);
        };

        ScrollTrigger.create({
            start: 0,
            end: () => ScrollTrigger.maxScroll(window) || document.documentElement.scrollHeight - window.innerHeight,
            onUpdate: scheduleTheme,
            onRefresh: scheduleTheme,
        });

        window.addEventListener("resize", scheduleTheme, { passive: true });

        /* El menú a pantalla completa tapa la página entera: mientras está
           abierto el fondo del navbar es el del overlay. No sirve el muestreo
           por puntos, porque el overlay solo se vuelve "clicable" a mitad de
           la animación de apertura; se lee su color directamente. */
        window.addEventListener("menu:state", (event) => {
            const open = Boolean((event as CustomEvent).detail?.open);
            container.toggleAttribute("data-menu-open", open);
            if (!open) {
                /* al cerrar, esperar a que el overlay desaparezca */
                window.setTimeout(applyTheme, 260);
                window.setTimeout(applyTheme, 720);
                return;
            }
            const overlay = document.querySelector<HTMLElement>("#site-menu-panel");
            const bg = overlay ? toRgba(getComputedStyle(overlay).backgroundColor) : null;
            container.dataset.navTheme = bg && bg[3] >= 0.5 ? bestInkFor(bg) : "dark";
        });

        /* Al navegar, la página nueva se pinta bajo la cortina de píxeles: el
           primer muestreo ocurre con ella delante. Cuando se retira, hay que
           volver a mirar. Lo mismo al volver con «atrás» desde la caché. */
        window.addEventListener("curtain:done", applyTheme);

        /* La portada pasa varios segundos con la intro delante. Su overlay es
           transparente, así que el muestreo la atraviesa y llega al fondo
           crema del documento: tinta negra. Cuando la intro termina aparece
           debajo el degradado del hero, que pide tinta crema, y hasta ahora
           nada volvía a mirar —en escritorio se salvaba de rebote porque al
           crearse ScrollSmoother se refresca ScrollTrigger, pero en móvil y
           en iOS no se crea—. `nav:reveal` llega cuando el navbar entra y
           `intro:finished` al acabar del todo. */
        window.addEventListener("nav:reveal", scheduleTheme);
        window.addEventListener("intro:finished", () => {
            applyTheme();
            window.setTimeout(applyTheme, 320);
        });
        window.addEventListener("pageshow", scheduleTheme);
        /* Las fuentes y las imágenes mueven el contenido después del primer
           muestreo; un repaso al terminar la carga lo deja en su sitio. */
        window.addEventListener("load", scheduleTheme, { once: true });

        applyTheme();
    };

    /* Hamburguesa -> panel escalonado (SiteMenu.tsx): el botón dispara el
       evento y el panel confirma el estado, que aquí se refleja en aria. */
    const initMenuButton = () => {
        const menuButton = document.getElementById("site-menu-button");
        if (!menuButton) return;
        menuButton.addEventListener("click", () => window.dispatchEvent(new CustomEvent("site-menu:toggle")));
        window.addEventListener("site-menu:state", (event) => {
            const detail = (event as CustomEvent).detail as { open?: boolean } | undefined;
            const open = Boolean(detail && detail.open);
            menuButton.setAttribute("aria-expanded", String(open));
            const label = open ? menuButton.dataset.closeLabel : menuButton.dataset.openLabel;
            if (label) menuButton.setAttribute("aria-label", label);
        });
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
            initNavSwitcher();
            initMenuButton();
        }, { once: true });
    } else {
        initNavSwitcher();
        initMenuButton();
    }
</script>
