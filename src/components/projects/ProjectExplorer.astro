---
import SectionIsland from "../SectionIsland.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import CmsImage from "../CmsImage.astro";
import type { CmsMedia } from "../../data/pages/types";
import flor from "../../assets/SVG/misc/flor.svg";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

export interface ProjectItem {
    /** id del elemento en la página (para anclas #proyecto) */
    anchor: string;
    category: string;
    categoryLabel?: string | null;
    type?: string | null;
    title: string;
    summary?: string | null;
    detail?: string | null;
    /** imagen del CMS (opcional) con asset local de respaldo */
    image?: CmsMedia;
    localImage?: ImageMetadata;
    imageAlt?: string | null;
    href: string;
    linkText?: string | null;
    external?: boolean | null;
    accent: string;
}

export interface ProjectFilter {
    /** clave de categoría ("all" muestra todo) */
    meta?: string | null;
    text: string;
}

interface Props {
    projects: ProjectItem[];
    filters?: ProjectFilter[];
    eyebrow?: string;
    title?: string;
}

const {
    projects,
    filters = [
        { meta: "all", text: "Todos" },
        { meta: "musica", text: "Música" },
        { meta: "liderazgo", text: "Liderazgo" },
        { meta: "comunicacion", text: "Comunicación" },
        { meta: "comunidad", text: "Comunidad" },
        { meta: "economia", text: "Economía" },
        { meta: "investigacion", text: "Investigación" },
    ],
    eyebrow = "Explora el ecosistema",
    title = "Proyectos y líneas de acción",
} = Astro.props;

const accentStyles: Record<string, string> = {
    primary: "var(--primary)",
    secondary: "var(--secondary)",
    accent: "var(--accent)",
};
const accentOf = (project: ProjectItem) => accentStyles[project.accent] ?? accentStyles.primary;
const hasImage = (project: ProjectItem) => Boolean(project.image?.url || project.localImage);
---

<SectionIsland tone="surface" padding="none" class="px-4 py-10 sm:px-8 sm:py-14 lg:px-14 lg:py-20" id="project-explorer" aria-labelledby="explorer-title">
    <div class="mb-10 flex flex-col gap-6 border-b border-black/10 pb-8 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <p class="mb-3 text-sm font-bold uppercase tracking-[0.22em] text-primary">{eyebrow}</p>
            <h2 data-scroll-float id="explorer-title" class="font-display text-4xl font-black text-black sm:text-6xl">{title}</h2>
        </div>

        <div class="flex flex-wrap gap-2" role="group" aria-label={t("projects.filter")}>
            {
                filters.map((filter, index) => (
                    <button
                        type="button"
                        class="project-filter min-h-11 rounded-full border border-black/15 px-4 py-2 text-sm font-bold transition hover:border-primary hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-pressed:bg-primary aria-pressed:text-white"
                        data-project-filter={filter.meta ?? "all"}
                        aria-pressed={index === 0 ? "true" : "false"}
                    >
                        {filter.text}
                    </button>
                ))
            }
        </div>
    </div>

    <p class="sr-only" aria-live="polite" data-project-status data-one={t("projects.visibleOne")} data-many={t("projects.visibleMany")}>
        {t(projects.length === 1 ? "projects.visibleOne" : "projects.visibleMany", { count: projects.length })}
    </p>

    <div class="grid gap-5 lg:grid-cols-2" data-project-grid>
        {
            projects.map((project, index) => (
                <article
                    id={project.anchor}
                    class={`project-card group relative min-h-[520px] overflow-hidden rounded-[2.25rem] ${hasImage(project) ? "lg:col-span-2 lg:min-h-[640px]" : ""}`}
                    data-project-card
                    data-category={project.category}
                >
                    {hasImage(project) ? (
                        <>
                            <CmsImage
                                media={project.image}
                                fallback={project.localImage}
                                alt={project.imageAlt ?? project.title}
                                widths={[720, 1280, 1920]}
                                sizes="100vw"
                                class="absolute inset-0 h-full w-full object-cover spring group-hover:scale-[1.03]"
                            />
                            <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(10,8,1,0.88)_0%,rgba(10,8,1,0.63)_45%,rgba(10,8,1,0.1)_100%)]" aria-hidden="true"></div>
                        </>
                    ) : (
                        <div class="absolute inset-0" style={`background: ${accentOf(project)};`} aria-hidden="true">
                            <Image src={flor} alt="" class="absolute -bottom-16 -right-14 h-72 w-72 rotate-12 opacity-15 spring group-hover:rotate-45 group-hover:scale-110" />
                            <span class="absolute right-8 top-5 font-display text-[10rem] font-black leading-none text-black/8">0{index + 1}</span>
                        </div>
                    )}

                    <div class={`relative z-10 flex h-full max-w-[760px] flex-col justify-end p-7 sm:p-10 lg:p-14 ${hasImage(project) || project.accent === "primary" ? "text-white" : "text-black"}`}>
                        <div class="mb-auto flex flex-wrap items-center gap-2">
                            <span class={`rounded-full px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] ${hasImage(project) || project.accent === "primary" ? "bg-white/15 text-white backdrop-blur" : "bg-black/10 text-black"}`}>{project.type}</span>
                            <span class={`rounded-full px-3 py-1 text-xs font-bold ${hasImage(project) || project.accent === "primary" ? "bg-accent text-black" : "bg-white/60 text-black"}`}>{project.categoryLabel}</span>
                        </div>

                        <h3 class="mt-16 max-w-[14ch] font-display text-5xl font-black leading-[0.94] sm:text-6xl">{project.title}</h3>
                        <p class={`mt-5 max-w-[58ch] text-lg leading-relaxed ${hasImage(project) || project.accent === "primary" ? "text-white/85" : "text-black/70"}`}>{project.summary}</p>
                        <p class={`mt-3 max-w-[58ch] text-sm leading-relaxed ${hasImage(project) || project.accent === "primary" ? "text-white/65" : "text-black/55"}`}>{project.detail}</p>
                        <a
                            href={project.href}
                            target={project.external ? "_blank" : undefined}
                            rel={project.external ? "noopener noreferrer" : undefined}
                            class={`mt-7 inline-flex w-fit min-h-12 items-center rounded-full px-5 py-3 font-display font-bold spring press hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-4 ${hasImage(project) || project.accent === "primary" ? "bg-white text-primary focus-visible:outline-white" : "bg-black text-white focus-visible:outline-black"}`}
                        >
                            {project.linkText}
                            <span class="ml-2" aria-hidden="true">↗</span>
                        </a>
                    </div>
                </article>
            ))
        }
    </div>
</SectionIsland>

<script>
    const initProjectExplorer = () => {
        const root = document.getElementById("project-explorer");
        if (!root || root.dataset.ready === "true") return;
        root.dataset.ready = "true";

        const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-project-filter]"));
        const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-project-card]"));
        const status = root.querySelector<HTMLElement>("[data-project-status]");

        const applyFilter = (category: string) => {
            let visibleCount = 0;
            cards.forEach((card) => {
                const visible = category === "all" || card.dataset.category === category;
                card.hidden = !visible;
                if (visible) visibleCount += 1;
            });
            buttons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.projectFilter === category)));
            if (status) {
                const template = (visibleCount === 1 ? status.dataset.one : status.dataset.many) ?? "{count}";
                status.textContent = template.replace("{count}", String(visibleCount));
            }
        };

        buttons.forEach((button) => button.addEventListener("click", () => applyFilter(button.dataset.projectFilter ?? "all")));
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initProjectExplorer, { once: true });
    } else {
        initProjectExplorer();
    }
</script>
