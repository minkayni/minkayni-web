---
import SectionHeading from "../components/SectionHeading.astro";
/* ──────────────────────────────────────────────────────────────────────────
   /donate — Aporta hoy.

   La cuenta institucional es el protagonista y aparece UNA sola vez: dentro
   de su ficha, los datos del giro internacional (SWIFT, direcciones, moneda)
   son un segundo nivel, no otra sección. Duplicar un dato bancario garantiza
   que algún día quede desactualizado en una de las dos copias.

   Debajo, dos rejillas de canales con botón, que comparten MethodCard:
   · paymentMethods → pasarelas de pago (Donorbox, PayPal…), cuando exista
                      una contratada.
   · transferApps   → apps de envío desde el exterior (Wise, Remitly).

   Un canal sin `href` no se pinta, así que la página nunca muestra un botón
   muerto mientras no haya pasarela.

   Los datos son texto seleccionable; los botones de copiar son mejora
   progresiva y sin JS la página funciona igual.

   Contenido editable en Strapi: single type `donate-page`.
─────────────────────────────────────────────────────────────────────────── */
import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/Button.astro";
import MethodCard from "../components/donate/MethodCard.astro";
import { Icon } from "astro-icon/components";
import { donateFallback, donateFallbackEn } from "../data/pages/donate";
import { loadPageContent } from "../utils/page-content";
import { getLocale, localizePath, useTranslations } from "../i18n";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
/* El fallback cambia con el idioma: el `donate-page` del CMS desplegado
   todavía no tiene los campos nuevos, así que hoy la página se sirve desde
   aquí en los dos idiomas. */
const d = await loadPageContent("donatePage", locale === "en" ? donateFallbackEn : donateFallback, locale);

type Account = (typeof d.accounts)[number];

/* Datos que pide una transferencia nacional. */
const localRows = (account: Account) =>
    [
        { label: t("donate.bank"), value: account.bank, copy: false, lead: false },
        { label: t("donate.accountType"), value: account.accountType, copy: false, lead: false },
        { label: t("donate.accountNumber"), value: account.accountNumber, copy: true, lead: true },
        { label: t("donate.holder"), value: account.holder, copy: false, lead: false },
        { label: t("donate.taxId"), value: account.taxId, copy: true, lead: false },
    ].filter((row) => Boolean(row.value));

/* Lo que un banco extranjero pide ADEMÁS de lo anterior. */
const wireRows = (account: Account) =>
    [
        { label: t("donate.swift"), value: account.swift, copy: true, lead: true },
        { label: t("donate.holderAddress"), value: account.holderAddress, copy: true, lead: false },
        { label: t("donate.bankAddress"), value: account.bankAddress, copy: true, lead: false },
        { label: t("donate.currency"), value: account.currency, copy: false, lead: false },
    ].filter((row) => Boolean(row.value));

/* Un solo bloque de texto con todo el giro: es lo que el donante pega en el
   formulario de su banco sin ir campo por campo. */
const wireBlock = (account: Account) => [...localRows(account), ...wireRows(account)].map((row) => `${row.label}: ${row.value}`).join("\n");

const paymentMethods = d.paymentMethods.filter((method) => method?.href && method?.name);
const transferApps = d.transferApps.filter((method) => method?.href && method?.name);
const faq = d.faq.filter((item) => item?.question && item?.answer);
---

<PageLayout title={t("page.donate")} description={d.seo.metaDescription}>
    <!-- Intro -->
    <section class="mx-auto w-[90%] max-w-[1100px] py-16 sm:py-24" aria-labelledby="donate-intro-title">
        <div class="max-w-[62ch]" data-reveal>
            <SectionHeading id="donate-intro-title" eyebrow={d.intro.eyebrow} title={d.intro.title} accent="text-secondary-deep" class="text-4xl leading-[0.95] text-black sm:text-6xl" />
            <p class="mt-6 text-lg leading-relaxed text-black/75">{d.intro.body}</p>
        </div>

        {
            d.channelLinks.length > 0 && (
                <nav class="mt-9 flex flex-wrap gap-3" aria-label={t("donate.shortcuts")} data-reveal>
                    {d.channelLinks.map((link) => (
                        <a
                            href={link.href}
                            class="inline-flex min-h-12 items-center gap-2 rounded-full border-2 border-black/15 px-6 py-3 font-display font-bold text-black spring press hover:-translate-y-0.5 hover:border-primary hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary motion-reduce:hover:translate-y-0"
                        >
                            <Icon name="mdi:arrow-down" class="h-4 w-4" aria-hidden="true" />
                            {link.text}
                        </a>
                    ))}
                </nav>
            )
        }
    </section>

    <!-- Cuenta institucional: el canal principal, con el giro internacional dentro -->
    <section class="mx-auto w-[94%] max-w-[1200px] rounded-[2.5rem] bg-primary px-6 py-14 text-white sm:px-12 lg:rounded-[4rem] lg:px-16 lg:py-20" aria-labelledby="donate-accounts-title">
        <div class="max-w-[62ch]" data-reveal>
            <SectionHeading id="donate-accounts-title" eyebrow={d.accountsHeading.eyebrow} title={d.accountsHeading.title} accent="text-secondary" eyebrowTone="secondary-light" class="text-4xl leading-[0.95] sm:text-6xl" />
            <p class="mt-6 text-lg leading-relaxed text-white/80">{d.accountsHeading.body}</p>
        </div>

        <ul class:list={["mt-12 grid gap-8", d.accounts.length > 1 && "xl:grid-cols-2"]} data-reveal-group>
            {
                d.accounts.map((account) => (
                    <li class="rounded-[2rem] bg-white/10 p-6 backdrop-blur sm:p-10">
                        <h3 class="font-display text-3xl font-black leading-tight sm:text-4xl">{account.bank}</h3>

                        <dl class="mt-8 divide-y divide-white/15">
                            {localRows(account).map((row) => (
                                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
                                    <dt class="text-xs font-bold uppercase tracking-[0.14em] text-white/80">{row.label}</dt>
                                    <dd class:list={["flex flex-wrap items-center gap-x-4 gap-y-2 font-display font-bold", row.lead ? "text-2xl sm:text-4xl" : "text-lg sm:text-xl"]}>
                                        <span class="select-all">{row.value}</span>
                                        {row.copy && (
                                            <button
                                                type="button"
                                                class="copy-btn inline-flex min-h-[2.25rem] items-center gap-1.5 rounded-full bg-white/15 px-4 py-2 text-xs font-bold uppercase tracking-[0.1em] transition hover:bg-white/30 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
                                                data-copy={row.value}
                                                data-label={row.label}
                                            >
                                                <Icon name="mdi:content-copy" class="h-4 w-4" aria-hidden="true" />
                                                <span class="copy-btn-text">{t("donate.copy")}</span>
                                            </button>
                                        )}
                                    </dd>
                                </div>
                            ))}
                        </dl>

                        {account.note && <p class="mt-5 text-sm leading-relaxed text-white/80">{account.note}</p>}

                        {wireRows(account).length > 0 && (
                            <div id="desde-el-exterior" class="mt-10 scroll-mt-28 rounded-[1.5rem] bg-black/20 p-6 sm:p-8">
                                <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-secondary-light">{d.internationalHeading.eyebrow}</p>
                                <h4 class="font-display text-2xl font-black leading-tight">{d.internationalHeading.title}</h4>
                                {d.internationalHeading.body && <p class="mt-3 max-w-[62ch] text-base leading-relaxed text-white/75">{d.internationalHeading.body}</p>}

                                <dl class="mt-6 divide-y divide-white/10">
                                    {wireRows(account).map((row) => (
                                        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3">
                                            <dt class="text-xs font-bold uppercase tracking-[0.14em] text-white/80">{row.label}</dt>
                                            <dd class:list={["flex flex-wrap items-center gap-x-4 gap-y-2 font-display font-bold", row.lead ? "text-xl sm:text-2xl" : "text-base sm:text-lg"]}>
                                                <span class="select-all">{row.value}</span>
                                                {row.copy && (
                                                    <button
                                                        type="button"
                                                        class="copy-btn inline-flex min-h-[2.25rem] items-center gap-1.5 rounded-full bg-white/15 px-4 py-2 text-xs font-bold uppercase tracking-[0.1em] transition hover:bg-white/30 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
                                                        data-copy={row.value}
                                                        data-label={row.label}
                                                    >
                                                        <Icon name="mdi:content-copy" class="h-4 w-4" aria-hidden="true" />
                                                        <span class="copy-btn-text">{t("donate.copy")}</span>
                                                    </button>
                                                )}
                                            </dd>
                                        </div>
                                    ))}
                                </dl>

                                <button
                                    type="button"
                                    class="copy-btn mt-6 inline-flex min-h-12 items-center gap-2 rounded-full bg-secondary px-7 py-3 font-display font-bold text-black spring press hover:-translate-y-0.5 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary motion-reduce:hover:translate-y-0"
                                    data-copy={wireBlock(account)}
                                    data-label={t("donate.wireDetails")}
                                >
                                    <Icon name="mdi:content-copy" class="h-4 w-4" aria-hidden="true" />
                                    <span class="copy-btn-text">{t("donate.copyAll")}</span>
                                </button>

                                {account.wireNote && <p class="mt-5 max-w-[70ch] text-sm leading-relaxed text-white/80">{account.wireNote}</p>}
                            </div>
                        )}
                    </li>
                ))
            }
        </ul>

        {d.transferNote && <p class="mt-8 max-w-[75ch] text-sm leading-relaxed text-white/75">{d.transferNote}</p>}

        <div class="mt-10 flex flex-wrap items-center gap-6">
            <Button href={d.contactButton.href} defaultText={d.contactButton.defaultText} hoverText={d.contactButton.hoverText} />
            {
                d.whatsappLink?.href && (
                    <a
                        href={d.whatsappLink.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 font-display font-bold text-white underline decoration-secondary underline-offset-4 transition hover:text-secondary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
                    >
                        <Icon name="mdi:whatsapp" class="h-5 w-5" aria-hidden="true" />
                        {d.whatsappLink.text}
                    </a>
                )
            }
        </div>

        <p
            class="sr-only"
            role="status"
            aria-live="polite"
            id="copy-status"
            data-copied={t("donate.copiedShort")}
            data-copied-item={t("donate.copiedItem")}
            data-copy-failed={t("donate.copyFailed")}
        >
        </p>
    </section>

    <!-- Pasarelas de pago en línea -->
    {
        paymentMethods.length > 0 && (
            <section class="mx-auto w-[90%] max-w-[1200px] py-20 sm:py-28" aria-labelledby="donate-methods-title">
                <div class="max-w-[62ch]" data-reveal>
                    <SectionHeading id="donate-methods-title" eyebrow={d.paymentMethodsHeading.eyebrow} title={d.paymentMethodsHeading.title} accent="text-primary" eyebrowTone="secondary-deep" class="text-4xl leading-[0.95] text-black sm:text-6xl" />
                    {d.paymentMethodsHeading.body && <p class="mt-6 text-lg leading-relaxed text-black/75">{d.paymentMethodsHeading.body}</p>}
                </div>

                <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
                    {paymentMethods.map((method) => (
                        <MethodCard
                            name={method.name!}
                            description={method.description ?? undefined}
                            href={method.href!}
                            linkText={method.linkText ?? undefined}
                            fee={method.fee ?? undefined}
                            icon={method.icon ?? undefined}
                        />
                    ))}
                </ul>
            </section>
        )
    }

    <!-- Apps de envío desde el exterior -->
    {
        transferApps.length > 0 && (
            <section class="mx-auto w-[90%] max-w-[1200px] py-20 sm:py-28" aria-labelledby="donate-apps-title">
                <div class="max-w-[62ch]" data-reveal>
                    <SectionHeading id="donate-apps-title" eyebrow={d.transferAppsHeading.eyebrow} title={d.transferAppsHeading.title} accent="text-primary" eyebrowTone="secondary-deep" class="text-4xl leading-[0.95] text-black sm:text-6xl" />
                    {d.transferAppsHeading.body && <p class="mt-6 text-lg leading-relaxed text-black/75">{d.transferAppsHeading.body}</p>}
                </div>

                <div class="mt-12 grid gap-5 lg:grid-cols-[1.4fr_1fr]" data-reveal-group>
                    <ul class="grid gap-5 sm:grid-cols-2">
                        {transferApps.map((app) => (
                            <MethodCard name={app.name!} description={app.description ?? undefined} href={app.href!} linkText={app.linkText ?? undefined} fee={app.fee ?? undefined} icon={app.icon ?? undefined} />
                        ))}
                    </ul>

                    {d.english?.title && (
                        <article class="rounded-[2rem] bg-accent p-7 text-black sm:p-8">
                            <h3 class="font-display text-2xl font-black leading-tight">{d.english.title}</h3>
                            {d.english.body && <p class="mt-3 text-base leading-relaxed text-black/80">{d.english.body}</p>}
                            {d.english.note && <p class="mt-3 text-sm leading-relaxed text-black/70">{d.english.note}</p>}
                        </article>
                    )}
                </div>
            </section>
        )
    }

    <!-- Preguntas frecuentes -->
    {
        faq.length > 0 && (
            <section class="mx-auto w-[90%] max-w-[1100px] pb-20 sm:pb-28" aria-labelledby="donate-faq-title">
                <div class="max-w-[62ch]" data-reveal>
                    <SectionHeading id="donate-faq-title" eyebrow={d.faqHeading.eyebrow} title={d.faqHeading.title} accent="text-secondary-deep" class="text-4xl leading-[0.95] text-black sm:text-6xl" />
                </div>

                <ul class="mt-12 space-y-4" data-reveal-group>
                    {faq.map((item) => (
                        <li>
                            <details class="group rounded-[1.5rem] border border-black/10 bg-white/60 px-6 py-5 open:bg-white/80">
                                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-lg font-black leading-snug text-black marker:hidden focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">
                                    {item.question}
                                    <Icon name="mdi:plus" class="h-5 w-5 shrink-0 text-primary spring group-open:rotate-45 motion-reduce:transition-none" aria-hidden="true" />
                                </summary>
                                <p class="mt-4 max-w-[75ch] text-base leading-relaxed text-black/75">{item.answer}</p>
                            </details>
                        </li>
                    ))}
                </ul>
            </section>
        )
    }

    <!-- A dónde va tu aporte -->
    <section class="mx-auto w-[90%] max-w-[1200px] pb-20 sm:pb-28" aria-labelledby="donate-impact-title">
        <div class="max-w-[62ch]" data-reveal>
            <SectionHeading id="donate-impact-title" eyebrow={d.impactHeading.eyebrow} title={d.impactHeading.title} accent="text-accent" eyebrowTone="secondary-deep" class="text-4xl leading-[0.95] text-primary sm:text-6xl" />
        </div>

        <ul class="mt-12 grid gap-5 md:grid-cols-3" data-reveal-group>
            {
                d.impactCards.map((card) => (
                    <li class="rounded-[1.75rem] border border-black/10 bg-white/60 px-6 py-7">
                        <h3 class="font-display text-xl font-black leading-snug text-black">{card.title}</h3>
                        <p class="mt-3 text-base leading-relaxed text-black/75">{card.description}</p>
                    </li>
                ))
            }
        </ul>
    </section>

    <!-- Otras formas de sumarse -->
    <section class="mx-auto mb-44 w-[90%] max-w-[1200px] pb-40" aria-labelledby="donate-other-title">
        <div class="max-w-[62ch]" data-reveal>
            <SectionHeading id="donate-other-title" eyebrow={d.otherWaysHeading.eyebrow} title={d.otherWaysHeading.title} accent="text-secondary-deep" class="text-4xl leading-[0.95] text-black sm:text-6xl" />
        </div>

        <ul class="mt-12 grid gap-5 md:grid-cols-3" data-reveal-group>
            {
                d.otherWays.map((card) => (
                    <li class="rounded-[1.75rem] bg-black/[0.04] px-6 py-7">
                        <h3 class="font-display text-xl font-black leading-snug text-black">{card.title}</h3>
                        <p class="mt-3 text-base leading-relaxed text-black/75">{card.description}</p>
                    </li>
                ))
            }
        </ul>

        {
            d.legalNote && (
                <p class="mt-12 max-w-[80ch] text-sm leading-relaxed text-black/70">
                    {d.legalNote}{" "}
                    <a href={localizePath("/transparencia", locale)} class="font-bold text-primary underline underline-offset-4 hover:text-secondary-deep">
                        Ver transparencia legal
                    </a>
                </p>
            )
        }
    </section>
</PageLayout>

<style>
    /* Safari sigue pintando el triángulo del summary con list-none. */
    summary::-webkit-details-marker {
        display: none;
    }
</style>

<script>
    /* El atajo a #desde-el-exterior necesita el helper de anclas: con
       ScrollSmoother activo el salto nativo del navegador no mueve el
       contenido. Sin JS el navegador salta igual. */
    import { initInPageAnchors } from "../scripts/anchors";

    initInPageAnchors();

    /* Copiar al portapapeles: mejora progresiva. Sin JS el dato sigue siendo
       texto seleccionable (`select-all`), así que la página funciona igual. */
    const status = document.getElementById("copy-status");

    document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
            const value = btn.dataset.copy ?? "";
            const label = btn.dataset.label ?? "";
            const text = btn.querySelector(".copy-btn-text");
            const original = text?.textContent ?? "";
            /* Los textos llegan traducidos en data-* de #copy-status. */
            const fill = (template: string | undefined) => (template ?? "").replace("{label}", label).replace("{value}", value);
            try {
                await navigator.clipboard.writeText(value);
                if (text && status?.dataset.copied) text.textContent = status.dataset.copied;
                if (status) status.textContent = fill(status.dataset.copiedItem);
                window.setTimeout(() => {
                    if (text) text.textContent = original;
                }, 2000);
            } catch {
                if (status) status.textContent = fill(status.dataset.copyFailed);
            }
        });
    });
</script>
