---
/* Una actividad de campo (/novedades/<slug>). La versión inglesa vive en
   /en/news/<slug>, con el mismo slug. Ver src/utils/actividades.ts. */
import ActividadView from "../../components/novedades/ActividadView.astro";
import { rutasDeActividades } from "../../utils/actividades";

export async function getStaticPaths() {
    return rutasDeActividades("es");
}

const { actividad, resumen, anterior, siguiente, relacionadas } = Astro.props;
---

<ActividadView {actividad} {resumen} {anterior} {siguiente} {relacionadas} locale="es" />
