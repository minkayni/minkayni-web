---
import { Image } from "astro:assets";
import PageLayout from "@/layouts/PageLayout.astro";
import Measure from "@/components/batucada/Measure.astro";
import Pulseline from "@/components/batucada/Pulseline.astro";
import Torn from "@/components/batucada/Torn.astro";
import CmsImage from "@/components/CmsImage.astro";
import Markdown from "@/components/Markdown.astro";
import { bp } from "@/components/batucada/tokens";
import BatucadaLogo from "@/assets/batucada-popular/logo-batucada-popular.svg";
import { batucadaFallback } from "@/data/pages/batucada";
import { loadPageContent } from "@/utils/page-content";
import { formatTitle, splitParagraphs } from "@/utils/rich-title";
import { sectorPhotos } from "@/utils/sector-photos";
import { viewerStrings } from "../../utils/viewer-strings";
import { getLocale, useTranslations } from "../../i18n";

/* Contenido: single type `batucada-page` en Strapi, con fallback local. */
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const d = await loadPageContent("batucadaPage", batucadaFallback, locale);

const methodSteps = d.methodSteps;
/* El orden de `sectors` enlaza la lista con los pines del mapa (data-bp-sectors). */
const sectors = d.sectors;
const communityActions = d.communityActions;
const awards = d.awards;
const ecosystem = d.ecosystemTags;
const figures = d.figures;
const introParagraphs = splitParagraphs(d.introBody ?? "");
/* Cada sector viaja al mapa con sus fotos ya resueltas: la miniatura de la
   polaroid y la grande del visor, ambas por el proxy /media. Un barrio sin
   fotos propias en el CMS usa las genéricas del proyecto. */
const STRAPI_BASE = (import.meta.env.STRAPI_URL ?? "").trim();
const sectorsJson = JSON.stringify(
    sectors.map(({ name, lat, lng, photos }) => ({
        name,
        lat,
        lng,
        photos: sectorPhotos(photos, STRAPI_BASE, t("batucada.photoOf", { name })),
    })),
);

/* Textos del mapa y del visor. Los scripts no conocen idiomas: las plantillas
   con `{index}`/`{count}` viajan sin rellenar y las completa quien las usa. */
const mapStringsJson = JSON.stringify({
    ...viewerStrings(t),
    open: t("viewer.open"),
    error: t("batucada.mapError"),
});

/* Clave de las teselas CARTO. Sin ella las teselas raster se sirven con una
   marca de agua "API key required". Lleva prefijo PUBLIC_ porque termina en el
   navegador —es inevitable en cualquier clave de mapa—: la protección real es
   restringirla por dominio en el panel de CARTO, no intentar ocultarla. */
const cartoKey = import.meta.env.PUBLIC_CARTO_KEY ?? "";
---

<PageLayout title={t("page.batucada")} showHero={false} description={d.seo.metaDescription}>
    <article class="overflow-clip bg-white text-black">
        <!-- ============ HERO: campo azul de marca ============ -->
        <header
            class:list={[
                bp.edge,
                bp.fieldBlue,
                "grid min-h-svh content-center gap-x-[clamp(1rem,2.5vw,2rem)] gap-y-[clamp(2.25rem,5vw,4.5rem)] pt-[calc(90px+clamp(1rem,2.5vw,2rem))] pb-[clamp(2.25rem,5vw,4.5rem)] lg:grid-cols-[minmax(28rem,1.02fr)_minmax(0,0.98fr)] lg:items-center",
                "[background-image:url(/batucada/semitono-soft.webp),var(--bp-rings-tr)] [background-size:cover,auto] [background-blend-mode:multiply,normal]",
            ]}
            aria-labelledby="bp-title"
        >
            <div class="flex min-w-0 flex-col items-start justify-center [container-type:inline-size]">
                <p class:list={[bp.eyebrow, "mb-[clamp(1rem,2.5vw,2rem)] flex w-full flex-wrap justify-between gap-x-6 gap-y-1 border-b-2 border-current pb-3"]} data-bp-hero>
                    <span>{d.heroMetaLeft}</span> <span>{d.heroMetaRight}</span>
                </p>
                <p class="relative my-[clamp(1rem,2.5vw,2rem)] inline-block -rotate-2 border-[3px] border-black bg-white px-[1.1rem] py-[0.9rem]" data-bp-hero>
                    <span class:list={[bp.tape, bp.tapeTL]} aria-hidden="true"></span>
                    <Image class="h-auto w-[clamp(7rem,12vw,10.5rem)]" src={BatucadaLogo} alt="Batucada Popular" loading="eager" />
                    <span class:list={[bp.tape, bp.tapeBR]} aria-hidden="true"></span>
                </p>
                <h1 id="bp-title" class:list={[bp.h1, bp.riso, "max-w-[14ch] text-black"]} data-bp-hero set:html={formatTitle(d.heroTitle ?? "")} />
                <div class="mt-[clamp(1.75rem,4vw,3rem)] flex flex-wrap items-center gap-x-6 gap-y-4" data-bp-hero>
                    <a class:list={[bp.button, bp.buttonYellow, "focus-visible:outline-black"]} href={d.heroPrimary.href}>{d.heroPrimary.text}</a>
                    <a class:list={[bp.textLink, "focus-visible:outline-black"]} href={d.heroSecondary.href}>{d.heroSecondary.text} <span class={bp.textLinkArrow} aria-hidden="true">↘</span></a>
                </div>
            </div>

            <figure class="min-w-0 lg:flex lg:flex-col lg:justify-center lg:self-stretch">
                {/* el eco vive en su propio contenedor relativo: cubre solo la
                    imagen, nunca el figcaption (que queda fuera) */}
                <div class:list={[bp.visual, "lg:flex lg:flex-1 lg:flex-col"]}>
                    <span class:list={[bp.echoPlate, "bg-black"]} aria-hidden="true"></span>
                    <div class:list={[bp.frame, "aspect-[4/3] lg:aspect-auto lg:min-h-96 lg:flex-1"]} data-bp-photo>
                        <span class:list={[bp.tape, bp.tapeTL]} aria-hidden="true"></span>
                        <CmsImage
                            media={d.heroImage}
                            fallback={d.heroLocalImage}
                            alt={t("alt.batucadaHero")}
                            class={bp.frameImg}
                            loading="eager"
                            widths={[720, 1080, 1600, 2200]}
                            sizes="(min-width: 64em) 48vw, 100vw"
                        />
                        <span class:list={[bp.tape, bp.tapeBR]} aria-hidden="true"></span>
                    </div>
                </div>
                <figcaption class="mt-4 max-w-[34ch] text-[0.78rem] font-black uppercase tracking-[0.14em] lg:self-end lg:text-right">{d.heroCaption}</figcaption>
            </figure>
        </header>

        <Pulseline />

        <!-- ============ 01 · QUIÉNES SOMOS + ORIGEN ============ -->
        <section id="historia" class:list={[bp.block, "scroll-mt-[92px]"]} aria-labelledby="intro-title" data-bp-scene>
            <Measure num="01" label={t("batucada.navWhoWeAre")} filled={2} />

            <p class:list={[bp.eyebrow]} data-bp-hit>{d.introHeading.eyebrow}</p>
            <h2 data-scroll-float
                id="intro-title"
                class:list={[bp.h2, "max-w-[13ch] text-[clamp(2.4rem,5vw,5.4rem)]"]}
                data-bp-hit
                set:html={formatTitle(d.introHeading.title, "text-primary underline decoration-bp-blue decoration-[0.08em] underline-offset-[0.12em]")}
            />

            <div class="mt-[clamp(2rem,4.5vw,3.5rem)] grid items-start gap-[clamp(2.25rem,5vw,4.5rem)] lg:grid-cols-[minmax(0,1.05fr)_minmax(24rem,0.95fr)]">
                <div>
                    <div class:list={[bp.body, "grid max-w-[60ch] gap-[clamp(1rem,2.5vw,2rem)]"]} data-bp-clave>
                        {introParagraphs.map((paragraph) => <p>{paragraph}</p>)}
                    </div>
                    <ul class="mt-[clamp(1.75rem,3.5vw,2.75rem)] flex flex-wrap gap-x-[1.6rem] gap-y-[1.1rem]" data-bp-clave>
                        {
                            figures.map((figure, index) => (
                                <li class:list={["grid gap-[0.2rem] rounded-[4px_8px_5px_7px] border-[3px] border-black bg-white px-[1.2rem] py-[0.85rem]", index % 2 ? "rotate-[1.2deg] shadow-[4px_4px_0_var(--accent)]" : "-rotate-1 shadow-[4px_4px_0_var(--color-bp-blue)]"]}>
                                    <strong class="font-bp text-[clamp(1.6rem,2.4vw,2.4rem)] leading-none [font-variant-numeric:tabular-nums]">
                                        {(figure.target ?? 0) > 0 ? (
                                            <>
                                                <span class="sr-only">{figure.value}</span>
                                                <span aria-hidden="true" data-bp-count={figure.target} data-bp-prefix={figure.prefix ?? ""}>
                                                    {figure.value}
                                                </span>
                                            </>
                                        ) : (
                                            figure.value
                                        )}
                                    </strong>
                                    <small class="text-[0.78rem] font-black uppercase tracking-[0.12em]">{figure.label}</small>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <aside class={bp.note} data-bp-hit aria-labelledby="origen-title">
                    <span class:list={[bp.tape, bp.tapeTL]} aria-hidden="true"></span>
                    <h3 id="origen-title" class:list={[bp.h3, "tracking-[0.02em]"]}>{d.originTitle}</h3>
                    <ol class="mt-6 grid gap-[1.15rem]">
                        {
                            d.originItems.map((item) => (
                                <li class="grid grid-cols-1 gap-y-1 text-base leading-[1.55] sm:grid-cols-[minmax(5.5rem,auto)_minmax(0,1fr)] sm:items-baseline sm:gap-x-[0.9rem]">
                                    <span class="font-bp text-[0.95rem] text-primary sm:whitespace-nowrap">{item.period}</span>
                                    <p>
                                        <strong class="block">{item.title}</strong>
                                        {item.text}
                                    </p>
                                </li>
                            ))
                        }
                    </ol>
                    <a class:list={[bp.textLink, "mt-7 focus-visible:outline-primary"]} href={d.originLink.href}>{d.originLink.text} <span class={bp.textLinkArrow} aria-hidden="true">↘</span></a>
                    <span class:list={[bp.tape, bp.tapeBR]} aria-hidden="true"></span>
                </aside>
            </div>
        </section>

        <Torn color="var(--bg-white)" border={1} field="none" />

        <!-- ============ INTERLUDIO · EL PULSO ============ -->
        <section class:list={[bp.edge, bp.fieldBlue, "grid items-center gap-[clamp(2.25rem,5vw,4.5rem)] py-[clamp(2.25rem,5vw,4.5rem)] lg:grid-cols-[minmax(0,1.02fr)_minmax(26rem,0.98fr)]"]} aria-labelledby="pulse-title" data-bp-scene>
            <figure class={bp.visual}>
                <span class:list={[bp.echoPlate, "bg-primary"]} aria-hidden="true"></span>
                <div class:list={[bp.frame, "aspect-[5/4]"]} data-bp-photo>
                    <span class:list={[bp.tape, bp.tapeTL]} aria-hidden="true"></span>
                    <CmsImage
                        media={d.pulseImage}
                        fallback={d.pulseLocalImage}
                        alt={t("alt.batucadaPulse")}
                        class={bp.frameImg}
                        widths={[640, 960, 1400, 1800]}
                        sizes="(min-width: 64em) 46vw, 100vw"
                    />
                    <span class:list={[bp.tape, bp.tapeBR]} aria-hidden="true"></span>
                </div>
            </figure>
            <div class="min-w-0">
                <p class={bp.eyebrow} data-bp-hit>{d.pulseHeading.eyebrow}</p>
                <h2 data-scroll-float id="pulse-title" class="font-bp mt-4 max-w-[12ch] text-balance text-[clamp(2.1rem,3.4vw,3.9rem)] uppercase leading-[0.96] tracking-[-0.03em]" data-bp-hit set:html={formatTitle(d.pulseHeading.title)} />
                <p class:list={[bp.body, "mt-7 max-w-[46ch]"]} data-bp-hit>{d.pulseHeading.body}</p>
                <p class:list={[bp.body, "mt-7 max-w-[46ch] border-t-[3px] border-black pt-6 font-black"]} data-bp-hit>{d.pulseHighlight}</p>
            </div>
        </section>

        <Torn color="#29aae1" border={2} flip field="blue" />

        <!-- ============ 02 · METODOLOGÍA ============ -->
        <section id="metodologia" class:list={[bp.block, bp.fieldInk, "scroll-mt-[92px]"]} aria-labelledby="method-title" data-bp-scene>
            <Measure num="02" label={t("batucada.navHowWeWork")} filled={4} numClass="text-bp-blue" />

            <p class:list={[bp.eyebrow, "text-bp-blue"]} data-bp-hit>{d.methodHeading.eyebrow}</p>
            <h2 data-scroll-float id="method-title" class:list={[bp.h2, "max-w-[14ch]"]} data-bp-hit set:html={formatTitle(d.methodHeading.title)} />

            <ol class="mt-[clamp(2rem,4.5vw,3.5rem)] border-t-[3px] border-white" data-bp-clave>
                {
                    methodSteps.map((step) => (
                        <li class="grid grid-cols-[3.5rem_minmax(0,1fr)] items-baseline gap-x-5 gap-y-[0.4rem] border-b-2 border-dashed border-white/30 py-[clamp(1.35rem,2.2vw,1.8rem)] sm:grid-cols-[3.5rem_minmax(11rem,0.55fr)_minmax(0,1fr)]">
                            <span class="font-bp row-span-2 text-[1.35rem] text-bp-blue sm:row-span-1" aria-hidden="true">
                                {step.number}
                            </span>
                            <h3 class="font-display text-[clamp(1.3rem,1.5vw,1.7rem)] font-black">{step.title}</h3>
                            <p class="col-start-2 max-w-[58ch] text-base leading-[1.55] text-bp-dim sm:col-start-auto">{step.text}</p>
                        </li>
                    ))
                }
            </ol>
            <p class="mt-[clamp(2rem,4.5vw,3.5rem)] max-w-[56ch] border-l-4 border-accent pl-5 font-black leading-[1.55]" data-bp-hit>{d.methodNote}</p>
        </section>

        <Torn color="var(--bg-black)" border={3} field="ink" />

        <!-- ============ 03 · TERRITORIO (mapa) ============ -->
        <section id="territorio" class:list={[bp.block, bp.fieldPurple, "scroll-mt-[92px]"]} aria-labelledby="territory-title" data-bp-scene>
            <Measure num="03" label={t("batucada.navWhereItSounds")} filled={6} numClass="text-white" />

            <p class={bp.eyebrow} data-bp-hit>{d.territoryHeading.eyebrow}</p>
            <h2 data-scroll-float id="territory-title" class:list={[bp.h2, "max-w-[14ch]"]} data-bp-hit set:html={formatTitle(d.territoryHeading.title, "text-accent")} />

            <div class="mt-[clamp(2rem,4.5vw,3.5rem)] grid items-stretch gap-[clamp(2.25rem,5vw,4.5rem)] lg:grid-cols-[minmax(24rem,0.9fr)_minmax(0,1.1fr)]">
                <div>
                    <p class:list={[bp.body, "max-w-[52ch]"]} data-bp-hit>{d.territoryHeading.body}</p>
                    <ol class="mt-[clamp(1.75rem,3vw,2.5rem)] grid grid-cols-[repeat(auto-fill,minmax(13rem,1fr))] gap-x-5 gap-y-2" data-bp-clave>
                        {
                            sectors.map((sector, index) => (
                                <li>
                                    <button type="button" class="group relative flex w-full cursor-pointer items-center py-2 pl-[2.8rem] text-left font-bold text-white focus-visible:outline-[3px] focus-visible:outline-offset-4 focus-visible:outline-white" data-bp-sector>
                                        <span class="absolute left-[0.3rem] top-1/2 aspect-square w-[1.9rem] -translate-y-1/2 rotate-45 border-2 border-black bg-bp-blue spring group-hover:scale-[1.15] group-hover:bg-accent group-data-[active]:scale-[1.15] group-data-[active]:bg-accent motion-reduce:transition-none" aria-hidden="true" />
                                        <span class="font-display absolute left-[0.3rem] top-1/2 grid w-[1.9rem] -translate-y-1/2 place-items-center text-[0.72rem] font-black text-black" aria-hidden="true">
                                            {String(index + 1).padStart(2, "0")}
                                        </span>
                                        {sector.name}
                                    </button>
                                </li>
                            ))
                        }
                    </ol>
                    <p class="mt-6 text-[0.9rem] text-white/80" data-bp-hit>{d.territoryHint}</p>
                </div>

                <div class="relative aspect-[4/3] min-h-[19rem] border-[3px] border-white bg-[#e8e0d3] lg:aspect-auto lg:min-h-[clamp(26rem,62svh,40rem)]">
                    <div id="bp-map" class="peer absolute inset-0 z-0" role="application" aria-label={t("batucada.mapLabel", { count: sectors.length })} aria-describedby="bp-map-status" aria-busy="true" data-state="idle" data-bp-sectors={sectorsJson} data-bp-strings={mapStringsJson} data-carto-key={cartoKey}></div>
                    <p id="bp-map-status" class="pointer-events-none absolute inset-x-0 bottom-3 z-[1] text-center text-[0.78rem] font-black uppercase tracking-[0.14em] text-black/70 peer-data-[state=ready]:hidden" data-bp-map-status role="status">{t("loading.map")}</p>
                    <button
                        type="button"
                        class="absolute bottom-3 left-3 z-[2] hidden -rotate-1 cursor-pointer border-2 border-black bg-accent px-3 py-[0.45rem] text-[0.7rem] font-black uppercase tracking-[0.08em] text-black shadow-[3px_3px_0_rgba(10,8,1,0.6)] spring hover:-translate-y-[2px] focus-visible:outline-[3px] focus-visible:outline-offset-4 focus-visible:outline-white peer-data-[state=ready]:inline-flex motion-reduce:transition-none"
                        data-bp-map-reset>{t("batucada.mapReset", { count: sectors.length })}</button
                    >
                </div>
            </div>
        </section>

        <Torn color="var(--primary)" border={4} field="purple" />

        <!-- ============ 04 · ACCIÓN COMUNITARIA ============ -->
        <section class={bp.block} aria-labelledby="action-title" data-bp-scene>
            <Measure num="04" label={t("batucada.navBeyondRehearsal")} filled={8} />

            <div class="grid items-center gap-[clamp(2.25rem,5vw,4.5rem)] lg:grid-cols-[minmax(0,1.05fr)_minmax(20rem,0.95fr)]">
                <div>
                    <p class={bp.eyebrow} data-bp-hit>{d.actionHeading.eyebrow}</p>
                    <h2 data-scroll-float id="action-title" class:list={[bp.h2, "max-w-[12ch]"]} data-bp-hit set:html={formatTitle(d.actionHeading.title)} />
                </div>
                <ol class="border-t-[3px] border-black" data-bp-clave>
                    {
                        communityActions.map((action, index) => (
                            <li class="group grid grid-cols-[2.6rem_minmax(0,1fr)] items-center gap-[1.15rem] border-b-2 border-dashed border-black/55 py-[clamp(1.2rem,1.9vw,1.6rem)]">
                                <span class="grid aspect-square w-[2.6rem] place-items-center border-2 border-black bg-bp-blue text-[0.9rem] font-black text-black spring group-hover:-rotate-[8deg] group-hover:scale-[1.08] motion-reduce:transition-none" aria-hidden="true">
                                    0{index + 1}
                                </span>
                                <p class="text-[clamp(1.15rem,1.8vw,1.7rem)] font-black">{action.text}</p>
                            </li>
                        ))
                    }
                </ol>
            </div>
        </section>

        <!-- ============ INTERLUDIO · ECOSISTEMA ============ -->
        <section class:list={[bp.block, bp.fieldInk]} aria-labelledby="eco-title" data-bp-scene>
            <p class:list={[bp.eyebrow, "text-bp-blue"]} data-bp-hit>{d.ecoHeading.eyebrow}</p>
            <h2 data-scroll-float id="eco-title" class:list={[bp.h2, "max-w-[12ch]"]} data-bp-hit set:html={formatTitle(d.ecoHeading.title)} />
            <p class:list={[bp.body, "mt-7 max-w-[56ch]"]} data-bp-hit>{d.ecoHeading.body}</p>
            <ul class="mt-[clamp(1.75rem,3.5vw,2.75rem)] flex flex-wrap gap-x-[1.1rem] gap-y-4" data-bp-clave>
                {
                    ecosystem.map((item, index) => (
                        <li class:list={["rounded-[3px_8px_4px_7px] border-2 px-4 py-[0.55rem] text-[0.85rem] font-black uppercase tracking-[0.08em]", index % 2 ? "rotate-[1deg] border-bp-blue text-bp-blue" : "-rotate-[1.2deg] border-white text-white"]}>{item.text}</li>
                    ))
                }
            </ul>
            <div class="mt-[clamp(1.75rem,4vw,3rem)] flex flex-wrap items-center gap-x-6 gap-y-4" data-bp-hit>
                <a class:list={[bp.textLink, "focus-visible:outline-bp-blue"]} href={d.ecoLink.href}>{d.ecoLink.text} <span class={bp.textLinkArrow} aria-hidden="true">↘</span></a>
            </div>
        </section>

        <Torn color="var(--bg-black)" border={1} flip field="ink" />

        <!-- ============ RECONOCIMIENTOS ============ -->
        <section class={bp.block} aria-labelledby="awards-title" data-bp-scene>
            <p class:list={[bp.eyebrow, "text-primary"]} data-bp-hit>{d.awardsHeading.eyebrow}</p>
            <h2 data-scroll-float id="awards-title" class:list={[bp.h2, "max-w-[13ch]"]} data-bp-hit set:html={formatTitle(d.awardsHeading.title)} />
            <ol class="mt-[clamp(2rem,4.5vw,3.5rem)] grid grid-cols-[repeat(auto-fill,minmax(min(19rem,100%),1fr))] gap-[clamp(1.5rem,2.5vw,2.25rem)]" data-bp-clave>
                {
                    awards.map((award, index) => (
                        <li class:list={["grid content-start gap-[0.9rem] border-[3px] border-black bg-white p-[clamp(1.4rem,2.4vw,2rem)] shadow-[5px_5px_0_rgba(10,8,1,0.85)]", index % 2 ? "rotate-[0.7deg]" : "-rotate-[0.7deg]"]}>
                            <span class="flex flex-wrap items-center gap-2">
                                {award.year && (
                                    <span class="font-bp -rotate-2 border-2 border-current px-[0.55rem] py-[0.2rem] text-base text-primary" aria-hidden="true">
                                        {award.year}
                                    </span>
                                )}
                                {award.recipient && (
                                    <span class="rounded-[3px_8px_4px_7px] border-2 border-black bg-bp-blue px-2 py-[0.2rem] text-[0.68rem] font-black uppercase tracking-[0.08em] text-black">
                                        {award.recipient}
                                    </span>
                                )}
                            </span>
                            <h3 class="text-[1.15rem] font-black leading-[1.3]">{award.title}</h3>
                            <p class="text-[0.95rem] leading-[1.55]">{award.text}</p>
                            {award.href && (
                                <a
                                    href={award.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="mt-1 inline-flex w-fit items-center gap-2 border-b-2 border-current pb-0.5 text-[0.78rem] font-black uppercase tracking-[0.14em] text-primary transition hover:text-black focus-visible:outline-[3px] focus-visible:outline-offset-4 focus-visible:outline-primary"
                                >
                                    {award.linkText ?? "Ver la fuente"} <span aria-hidden="true">↗</span>
                                </a>
                            )}
                        </li>
                    ))
                }
            </ol>
            <div class="mt-[clamp(2.25rem,5vw,4.5rem)] border-t-2 border-black pt-5 text-[0.95rem] [&_a]:font-black [&_a]:text-primary [&_a]:underline [&_a]:underline-offset-[0.18em] [&_a:hover]:text-black" data-bp-hit>
                <Markdown of={d.awardsNote} />
            </div>
        </section>

        <!-- ============ CODA · DERECHOS ============ -->
        <section class:list={[bp.block, bp.fieldInk]} aria-labelledby="rights-title" data-bp-scene>
            <p class:list={[bp.eyebrow, "text-bp-blue"]} data-bp-hit>{d.rightsHeading.eyebrow}</p>
            <h2 data-scroll-float
                id="rights-title"
