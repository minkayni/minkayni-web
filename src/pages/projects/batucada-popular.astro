<style is:global>
    /* Único CSS irreducible: estilos sobre DOM generado por Leaflet
       (no existe en nuestras plantillas, así que no puede llevar utilidades). */
    #bp-map .leaflet-tile-pane {
        /* Voyager casi natural con más punch: agua, calles y parques se
           distinguen por color — cualquier grayscale los colapsa en crema
           y "desaparece" la ciudad. */
        filter: contrast(1.08) saturate(1.25);
    }

    #bp-map.leaflet-container {
        font-family: "Aristotelica Pro Text", "Aristotelica Pro Text Fallback", "Aristotelica Pro Text Fallback Android", "Nunito", system-ui, sans-serif;
        background: #e8e0d3;
    }

    /* Tarjetas polaroid (hover y galería por clic): la entrada anima el
       <figure> interno con `transform`; la posición usa la propiedad
       `translate` — no compiten. Viven fuera del overflow del mapa para
       poder desbordar el marco. */
    .bp-hover-card .bp-tip,
    .bp-map-gallery .bp-tip {
        transform-origin: bottom center;
        animation: bp-tip-in 240ms cubic-bezier(0.34, 1.35, 0.4, 1) both;
    }

    /* el collage además flota suavemente, desfasado por tarjeta (los dos
       delays vienen inline desde map.ts: entrada primero, flotado después).
       La tira de miniaturas del móvil no flota: en fila, marea. */
    .bp-map-gallery[data-layout="scatter"] .bp-tip {
        animation:
            bp-tip-in 240ms cubic-bezier(0.34, 1.35, 0.4, 1) both,
            bp-float 3.4s ease-in-out infinite alternate;
    }

    @keyframes bp-tip-in {
        from {
            opacity: 0;
            transform: translateY(8px) scale(0.88) rotate(-2deg);
        }
    }

    @keyframes bp-float {
        from {
            transform: translateY(0);
        }
        to {
            transform: translateY(-6px);
        }
    }

    /* La tarjeta de hover cae por debajo del pin cuando arriba no cabe
       (lo decide gallery-layout.ts y lo marca con data-place). */
    .bp-hover-card[data-place="below"] {
        translate: -50% 14px;
    }

    /* ── Visor a pantalla completa (scripts/batucada/viewer.ts) ───────────
       El visor entra con un fundido y el marco con el mismo rebote que las
       polaroids: es la misma foto, ampliada. La foto se funde al cambiar
       para que el marco no se quede vacío en una red lenta. */
    .bp-viewer {
        animation: bp-viewer-in 180ms ease-out both;
    }

    .bp-viewer__frame {
        animation: bp-viewer-frame-in 260ms cubic-bezier(0.34, 1.35, 0.4, 1) both;
    }

    .bp-viewer__image {
        transition: opacity 160ms ease-out;
    }

    .bp-viewer__image.is-loading {
        opacity: 0;
    }

    @keyframes bp-viewer-in {
        from {
            opacity: 0;
        }
    }

    @keyframes bp-viewer-frame-in {
        from {
            opacity: 0;
            transform: scale(0.94) translateY(10px);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        /* `[data-layout]` iguala la especificidad de la regla que pone el
           flotado: sin él, el collage seguía moviéndose con el movimiento
           reducido activado. */
        .bp-hover-card .bp-tip,
        .bp-map-gallery[data-layout] .bp-tip,
        .bp-viewer,
        .bp-viewer__frame {
            animation: none;
        }

        .bp-viewer__image {
            transition: none;
        }
    }

    #bp-map .leaflet-control-attribution {
        background: rgb(255 246 229 / 0.85);
        color: var(--bg-black);
        font-size: 0.62rem;
    }

    #bp-map .leaflet-control-zoom a {
        border: 2px solid var(--bg-black);
        color: var(--bg-black);
        background: var(--bg-white);
    }

</style>
